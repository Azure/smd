  "schemaDefinitions": {
    "ProductionStatusEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.ProductionStatusEnumeration",
      "const": {
        "OTHER": 0,
        "NO_PRODUCTION": 1,
        "START_UP": 2,
        "READY_FOR_PRODUCTION": 3,
        "PRODUCTION": 4,
        "DRY_RUN": 5
      },
      "description": "Production status of the machine",
      "properties": {
        "OTHER": {
          "description": "This state is used if none of the other states below apply",
          "type": "integer"
        },
        "NO_PRODUCTION": {
          "description": "The machine does not produce any parts/products",
          "type": "integer"
        },
        "START_UP": {
          "description": "The machine is producing parts/products in the start-up phase. So the correct settings of the machines are not reached.",
          "type": "integer"
        },
        "READY_FOR_PRODUCTION": {
          "description": "The machine is producing parts/products, the correct settings of the machines are reached but the production is not yet released (e.g. waiting for release from quality assurance)",
          "type": "integer"
        },
        "PRODUCTION": {
          "description": "The machine is producing parts/products. In semi-automatic mode also during waiting time (e.g. for manual loading/unloading of parts) ProductionStatus remains in this state (time out possible if e.g. cycle time exceeds a pre-defined limit)",
          "type": "integer"
        },
        "DRY_RUN": {
          "description": "The machine is moving without material",
          "type": "integer"
        }
      }
    }
  },
