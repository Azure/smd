            "maximum": 3.40e+38
          }
        }
      }
    },
    "SetFlowRate": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.InputArguments",
        "required": [
          "FlowRate",
          "SEM",
          "ShutdownRequest"
        ],
        "properties": {
          "FlowRate": {
            "description": "Target flow rate. The CIMV will automatically maintain this target flow",
            "type": "number",
            "minimum": -3.40e+38,
            "maximum": 3.40e+38
          },
          "SEM": {
            "title": "SEMEnum",
            "description": "The selection of which SEM to send the command to",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "ShutdownRequest": {
            "description": "Boolean indicates that this command is part of a shutdown sequence. ",
            "type": "boolean"
          }
        }
      }
    },
    "SetManual": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.InputArguments",
        "required": [
          "Direction",
          "Delta",
          "SEM",
          "ShutdownRequest"
        ],
        "properties": {
          "Direction": {
            "title": "CIMVMoveEnum",
            "description": "Direction to move – Open or Close",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.CIMVMoveEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "Delta": {
            "description": "A relative change in position from the current position as a percent. ",
            "type": "number",
            "minimum": -3.40e+38,
            "maximum": 3.40e+38
          },
          "SEM": {
            "title": "SEMEnum",
            "description": "The selection of which SEM to send the command to",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "ShutdownRequest": {
            "description": "Boolean indicates that this command is part of a shutdown sequence. ",
            "type": "boolean"
          }
        }
      }
    },
    "SetOperationMode": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.InputArguments",
        "required": [
          "Mode",
          "SEM",
          "ShutdownRequest"
        ],
        "properties": {
          "Mode": {
            "title": "CIMVOperationModeEnum",
            "description": "Enumeration indicating the requested operation mode",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.CIMVOperationModeEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "SEM": {
            "title": "SEMEnum",
            "description": "The selection of which SEM to send the command to",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "ShutdownRequest": {
            "description": "Boolean indicating if the open or close command should override any interlocks",
            "type": "boolean"
          }
        }
      }
    },
    "SetPosition": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.InputArguments",
        "required": [
          "Position",
          "SEM",
          "ShutdownRequest"
        ],
        "properties": {
          "Position": {
            "description": "Target position as percent of open. The CIMV will automatically maintain this position",
            "type": "number",
            "minimum": -3.40e+38,
            "maximum": 3.40e+38
          },
          "SEM": {
            "title": "SEMEnum",
            "description": "The selection of which SEM to send the command to",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
