    "BACnetReliability": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.BACnet_V2.BACnetReliability",
      "const": {
        "NoFaultDetected": 0,
        "NoSensor": 1,
        "OverRange": 2,
        "UnderRange": 3,
        "OpenLoop": 4,
        "ShortedLoop": 5,
