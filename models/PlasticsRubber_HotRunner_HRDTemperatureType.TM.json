  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.PlasticsRubber.GeneralTypes.ControlledParameterType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/properties/BoostSetValue",
    "/properties/BoostTime",
    "/properties/SecondSetValue",
    "/properties/StandbySetValue",
    "/properties/TimeMethodPIDParameters",
    "/events/BoostSetValue",
