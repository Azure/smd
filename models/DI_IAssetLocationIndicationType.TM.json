  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.DI.IAssetLocationIndicationType",
  "title": "DI_IAssetLocationIndicationType",
  "dov:typeRef": "org.opcfoundation.UA.DI.IAssetLocationIndicationType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.BaseInterfaceType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "LocationIndicationType": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.DI.LocationIndicationType",
      "const": {
        "Visual": 0,
        "Audible": 1
      },
      "properties": {
        "Visual": {
          "description": "Location indication through optical signals, such as blinking LEDs, if supported by the device.",
          "type": "integer"
        },
        "Audible": {
          "description": "Location indication through auditory signals, such as sounds or beeps, if supported by the device.",
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
    "/properties/SupportedIndicationTypes",
    "/properties/UsedIndicationType"
  ],
  "actions": {
    "StartLocationIndication": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.DI.InputArguments",
        "required": [
          "IndicationDuration"
        ],
        "properties": {
          "IndicationDuration": {
            "type": "string",
            "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
          }
        }
      }
    },
    "StopLocationIndication": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/"
    }
  },
  "properties": {
    "IsIndicating": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "type": "boolean",
      "readOnly": true
    },
    "SupportedIndicationTypes": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "title": "LocationIndicationType",
      "dov:typeRef": "org.opcfoundation.UA.DI.LocationIndicationType",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "readOnly": true
    },
    "UsedIndicationType": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "title": "LocationIndicationType",
      "dov:typeRef": "org.opcfoundation.UA.DI.LocationIndicationType",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "readOnly": true
    }
  }
