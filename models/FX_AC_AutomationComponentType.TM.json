  "schemaDefinitions": {
    "AssetVerificationModeEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.AssetVerificationModeEnum",
      "const": {
        "AssetCompatibility": 0,
        "AssetIdentity": 1,
        "AssetIdentityAndCompatibility": 2
      },
      "properties": {
        "AssetCompatibility": {
          "description": "Verify whether an Asset’s functionality matches or is compatible to the expectation of system engineering.",
          "type": "integer"
        },
        "AssetIdentity": {
          "description": "Verify whether an Asset’s identity meets the expectation of system engineering.",
          "type": "integer"
        },
        "AssetIdentityAndCompatibility": {
          "description": "Verify whether an Asset’s identity meets the expectation of system engineering and whether its functionality matches or is compatible to the expectation of system engineering.",
          "type": "integer"
        }
      }
    },
    "AssetVerificationResultEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.AssetVerificationResultEnum",
      "const": {
        "NotSet": 0,
        "Match": 1,
        "Compatible": 2,
        "Mismatch": 3
      },
      "properties": {
        "NotSet": {
          "description": "The verification result is not set.",
          "type": "integer"
        },
        "Match": {
          "description": "Asset matches expectation.",
          "type": "integer"
        },
        "Compatible": {
          "description": "Asset does not match expectation but is compatible.",
          "type": "integer"
        },
        "Mismatch": {
          "description": "Asset does not match expectation and is not compatible.",
          "type": "integer"
        }
      }
    },
    "DeviceHealthOptionSet": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.AC.DeviceHealthOptionSet",
      "const": {
        "DeviceFailure": 0,
        "DeviceCheckFunction": 1,
        "DeviceMaintenanceRequired": 2,
        "DeviceOffSpec": 3
      },
      "properties": {
        "DeviceFailure": {
          "description": "At least one of the top-level Assets has its DeviceHealth set to Failure.",
          "type": "integer"
        },
        "DeviceCheckFunction": {
          "description": "At least one of the top-level Assets has its DeviceHealth set to CheckFunction.",
          "type": "integer"
        },
        "DeviceMaintenanceRequired": {
          "description": "At least one of the top-level Assets has its DeviceHealth set to MaintenanceRequired.",
          "type": "integer"
        },
        "DeviceOffSpec": {
          "description": "At least one of the top-level Assets has its DeviceHealth set to OffSpec.",
          "type": "integer"
        }
      }
    },
    "FunctionalEntityVerificationResultEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.FunctionalEntityVerificationResultEnum",
      "const": {
        "NotSet": 0,
        "Match": 1,
        "Mismatch": 2
      },
      "properties": {
        "NotSet": {
          "description": "The verification result is not set.",
          "type": "integer"
        },
        "Match": {
          "description": "FunctionalEntity matches expectation.",
          "type": "integer"
        },
        "Mismatch": {
          "description": "FunctionalEntity does not match expectation.",
          "type": "integer"
        }
      }
    },
    "FxCommandMask": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.FxCommandMask",
      "const": {
        "VerifyAssetCmd": 0,
        "VerifyFunctionalEntityCmd": 1,
        "CreateConnectionEndpointCmd": 2,
        "EstablishControlCmd": 3,
        "SetConfigurationDataCmd": 4,
        "ReassignControlCmd": 5,
        "ReserveCommunicationIdsCmd": 6,
        "SetCommunicationConfigurationCmd": 7,
        "EnableCommunicationCmd": 8
      },
      "description": "This OptionSet defines flags indicating the commands a ConnectionManager may use in its call to the EstablishConnections Method.",
      "properties": {
        "VerifyAssetCmd": {
          "description": "The addressed Server shall verify compatibility and/or identity for all requested Assets.",
          "type": "integer"
        },
        "VerifyFunctionalEntityCmd": {
          "description": "The addressed Server shall verify compatibility for all requested functional entities.",
          "type": "integer"
        },
        "CreateConnectionEndpointCmd": {
          "description": "The addressed Server shall create or modify ConnectionEndpoints. ",
          "type": "integer"
        },
        "EstablishControlCmd": {
          "description": "The addressed Server shall establish control over the requested ControlGroups.",
          "type": "integer"
        },
        "SetConfigurationDataCmd": {
          "description": "The addressed Server shall apply the supplied application configuration.",
          "type": "integer"
        },
        "ReassignControlCmd": {
          "description": "The addressed Server shall reassign the requested ControlGroups.",
          "type": "integer"
        },
        "ReserveCommunicationIdsCmd": {
          "description": "The addressed Server shall reserve identifiers for the communication model configuration.",
          "type": "integer"
        },
        "SetCommunicationConfigurationCmd": {
          "description": "The addressed Server shall apply the supplied communication model configuration.",
          "type": "integer"
        },
        "EnableCommunicationCmd": {
          "description": "The addressed Server shall enable the communication configuration.",
          "type": "integer"
        }
      }
    },
    "OperationalHealthOptionSet": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.AC.OperationalHealthOptionSet",
      "const": {
        "OperationalWarning": 16,
        "OperationalError": 17,
        "SubOperationalWarning": 18,
        "SubOperationalError": 19
      },
      "properties": {
        "OperationalWarning": {
          "description": "FunctionalEntity indicates a warning.",
          "type": "integer"
        },
        "OperationalError": {
          "description": "FunctionalEntity indicates an error.",
          "type": "integer"
        },
        "SubOperationalWarning": {
          "description": "One of the SubFunctionalEntities indicates a warning.",
          "type": "integer"
        },
        "SubOperationalError": {
          "description": "One of the SubFunctionalEntities indicates an error.",
          "type": "integer"
        }
      }
    },
    "AggregatedHealthType": {
