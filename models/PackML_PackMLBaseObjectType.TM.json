                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "CmdValue": {
                  "description": "This is the command value associated with the ControlCmdNumber above.",
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "Parameter": {
                  "description": "The parameter tags associated to commanded remote interface are typically used for command parameters that are given to the unit machine from remote machines.",
