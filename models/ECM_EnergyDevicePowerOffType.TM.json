  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/ECM/#ECM_EnergyDevicePowerOffType",
  "title": "ECM_EnergyDevicePowerOffType",
  "dov:typeRef": "org.opcfoundation.UA.ECM.EnergyDevicePowerOffType",
  "dov:isComposite": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/#OpcUaCore_BaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "actions": {
    "SwitchOffWOL": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "output": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.OutputArguments",
        "required": [
          "ModeID",
          "CurrentTimeToDestination",
          "RegularTimeToOperate",
          "TimeMinLengthOfStay",
          "ReturnCode"
        ],
        "properties": {
          "ModeID": {
            "description": "ID of the destination energy saving mode (0xFE)  if successful, otherwise unchanged.",
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "CurrentTimeToDestination": {
            "description": "Time needed to reach the energy saving mode if successful, otherwise unchanged.",
            "type": "string",
            "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
          },
          "RegularTimeToOperate": {
            "description": "Time needed to reach PE_ready_to_operate again if the destination energy saving mode will be regularly terminated if successful, otherwise unchanged.",
            "type": "string",
            "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
          },
          "TimeMinLengthOfStay": {
            "description": "Time of minimum stay in the destination energy saving mode if successful, otherwise unchanged.",
            "type": "string",
            "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
          },
          "ReturnCode": {
            "description": "Return code.",
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "properties": {
    "ModePowerConsumption": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "readOnly": true
    },
    "RegularTimeToOperate": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": true
    },
    "TimeMinPause": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": true
    },
    "WOLMagicPacket": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "type": "string",
      "contentEncoding": "base64",
      "readOnly": true
    }
  },
  "events": {
    "ModePowerConsumption": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "data": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "RegularTimeToOperate": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "data": {
        "type": "string",
        "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
      }
    },
    "TimeMinPause": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "data": {
        "type": "string",
        "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
      }
    }
  }
}