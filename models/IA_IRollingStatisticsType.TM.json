{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.IA.IRollingStatisticsType",
  "title": "IA_IRollingStatisticsType",
  "dov:typeRef": "org.opcfoundation.UA.IA.IRollingStatisticsType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.IA.IStatisticsType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/properties/WindowDuration",
    "/properties/WindowNumberOfValues"
  ],
  "properties": {
    "WindowDuration": {
      "dov:namespace": "http://opcfoundation.org/UA/IA/",
      "description": "The duration after the statistical data are rolled over. Only the data that were gathered during that duration are considered for the statistical data, even if the time interval between the StartTime and the current time is longer.",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": false
    },
    "WindowNumberOfValues": {
      "dov:namespace": "http://opcfoundation.org/UA/IA/",
      "description": "The number of values before the data gets rolled over. For the statistical data, only the data fitting into the number of values is considered, even if more data were gathered since StartTime.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "readOnly": false
    }
  }
}