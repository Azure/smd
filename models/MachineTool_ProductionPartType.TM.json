  "schemaDefinitions": {
    "PartQuality": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MachineTool.PartQuality",
      "const": {
        "CapabilityUnavailable": 0,
        "Good": 1,
        "Bad": 2,
        "NotYetMeasured": 3,
        "WillNotBeMeasured": 4
      },
      "properties": {
        "CapabilityUnavailable": {
          "description": "The machine tool is not able to give a statement about the part quality.",
          "type": "integer"
        },
        "Good": {
          "description": "The part quality is determined good.",
          "type": "integer"
        },
        "Bad": {
          "description": "The part quality is determined bad.",
          "type": "integer"
        },
        "NotYetMeasured": {
          "description": "The PartQuality will still be determined in the machine tool to be either Good or Bad.",
          "type": "integer"
        },
        "WillNotBeMeasured": {
          "description": "The machine tool will not give a statement about the part quality.",
          "type": "integer"
        }
      }
    },
    "ProcessIrregularity": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MachineTool.ProcessIrregularity",
      "const": {
        "CapabilityUnavailable": 0,
        "Detected": 1,
        "NotDetected": 2,
        "NotYetDetermined": 3
      },
      "properties": {
        "CapabilityUnavailable": {
          "description": "The machine tool is not able to give a statement about process irregularities.",
          "type": "integer"
        },
        "Detected": {
          "description": "A process irregularity has been detected.",
          "type": "integer"
        },
        "NotDetected": {
          "description": "There was no process irregularity detected.",
          "type": "integer"
        },
        "NotYetDetermined": {
          "description": "A statement about the process irregularity is to be expected.",
          "type": "integer"
        }
      }
    }
  },
