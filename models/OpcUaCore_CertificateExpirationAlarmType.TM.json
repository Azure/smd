    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.CertificateExpirationAlarmType",
  "title": "OpcUaCore_CertificateExpirationAlarmType",
  "dov:typeRef": "org.opcfoundation.UA.CertificateExpirationAlarmType",
  "dov:isEvent": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.SystemOffNormalAlarmType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/properties/ExpirationLimit"
  ],
  "properties": {
