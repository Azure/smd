{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/DI/PackageMetadata/#DI_PackageMetadata_PackageMetadata",
  "title": "DI_PackageMetadata_PackageMetadata",
  "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.PackageMetadata",
  "links": [],
  "schemaDefinitions": {
    "PackageMetadata": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.PackageMetadata",
      "required": [
        "Name",
        "ManufacturerUri",
        "Manufacturer",
        "PackageRevision",
        "PackageType"
      ],
      "properties": {
        "Name": {
          "type": "string"
        },
        "Description": {
          "type": "string"
        },
        "ManufacturerUri": {
          "type": "string"
        },
        "Manufacturer": {
          "type": "string"
        },
        "PackageRevision": {
          "type": "string"
        },
        "PackageType": {
          "title": "PackageType",
          "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.PackageType",
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "SoftwareSubClass": {
          "type": "string"
        },
        "DeployCompletePackage": {
          "type": "boolean"
        },
        "SoftwareRevision": {
          "type": "string"
        },
        "ReleaseDate": {
          "type": "string",
          "format": "date-time"
        },
        "TargetManufacturerUri": {
          "type": "string"
        },
        "TargetManufacturer": {
          "type": "string"
        },
        "UpdateTargets": {
          "type": "array",
          "items": {
            "title": "UpdateTarget",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.UpdateTarget",
            "required": [
              "ProductCode",
              "Model"
            ],
            "properties": {
              "ProductCode": {
                "type": "string"
              },
              "Model": {
                "type": "string"
              }
            }
          }
        },
        "Files": {
          "type": "array",
          "items": {
            "title": "FileDescriptor",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.FileDescriptor",
            "required": [
              "FileType",
              "FileName"
            ],
            "properties": {
              "FileType": {
                "title": "FileType",
                "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.FileType",
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "FileName": {
                "type": "string"
              },
              "MimeType": {
                "type": "string"
              },
              "Language": {
                "type": "string"
              }
            }
          }
        },
        "Compatibilities": {
          "type": "array",
          "items": {
            "title": "CompatibilityOption",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.CompatibilityOption",
            "required": [
              "CompatibilityRequirements"
            ],
            "properties": {
              "CompatibilityRequirements": {
                "type": "array",
                "items": {
                  "title": "CompatibilityRequirement",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.CompatibilityRequirement",
                  "required": [
                    "Variable",
                    "Values",
                    "Operation"
                  ],
                  "properties": {
                    "Variable": {
                      "type": "string"
                    },
                    "Values": {
                      "type": "array",
                      "items": {
                        "description": "Stand-in for an unspecified data type.",
                        "type": "string"
                      }
                    },
                    "Operation": {
                      "title": "ComparisonOperation",
                      "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.ComparisonOperation",
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    }
                  }
                }
              }
            }
          }
        },
        "Assignments": {
          "type": "array",
          "items": {
            "title": "Assignment",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.Assignment",
            "required": [
              "Subpackage",
              "Targets"
            ],
            "properties": {
              "Subpackage": {
                "type": "string"
              },
              "InstallationOrder": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "Targets": {
                "type": "array",
                "items": {
                  "title": "PackageTarget",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.PackageTarget",
                  "properties": {
                    "TargetType": {
                      "type": "string"
                    },
                    "TargetNode": {
                      "type": "string"
                    },
                    "ProductInstanceUri": {
                      "type": "string"
                    },
                    "AssetId": {
                      "type": "string"
                    },
                    "ManufacturerUri": {
                      "type": "string"
                    },
                    "ProductCode": {
                      "type": "string"
                    },
                    "SerialNumber": {
                      "type": "string"
                    },
                    "FxPath": {
                      "type": "array",
                      "items": {
                        "title": "FxPathElement",
                        "type": "object",
                        "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.FxPathElement",
                        "required": [
                          "AssetConnectorType"
                        ],
                        "properties": {
                          "AssetConnectorType": {
                            "type": "string"
                          },
                          "ConnectorId": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          },
                          "ConnectorName": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "FxScope": {
                      "type": "array",
                      "items": {
                        "title": "FxPathElement",
                        "type": "object",
                        "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.FxPathElement",
                        "required": [
                          "AssetConnectorType"
                        ],
                        "properties": {
                          "AssetConnectorType": {
                            "type": "string"
                          },
                          "ConnectorId": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          },
                          "ConnectorName": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "BrowsePath": {
                      "type": "array",
                      "items": {
                        "title": "RelativePathElement",
                        "type": "object",
                        "dov:typeRef": "org.opcfoundation.UA.RelativePathElement",
                        "required": [
                          "ReferenceTypeId",
                          "IsInverse",
                          "IncludeSubtypes",
                          "TargetName"
                        ],
                        "properties": {
                          "ReferenceTypeId": {
                            "type": "string"
                          },
                          "IsInverse": {
                            "type": "boolean"
                          },
                          "IncludeSubtypes": {
                            "type": "boolean"
                          },
                          "TargetName": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "TargetServer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}