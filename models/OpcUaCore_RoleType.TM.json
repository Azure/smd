{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.RoleType",
  "title": "OpcUaCore_RoleType",
  "dov:typeRef": "org.opcfoundation.UA.RoleType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.BaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "IdentityCriteriaType": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.IdentityCriteriaType",
      "const": {
        "UserName": 1,
        "Thumbprint": 2,
        "Role": 3,
        "GroupId": 4,
        "Anonymous": 5,
        "AuthenticatedUser": 6,
        "Application": 7,
        "X509Subject": 8,
        "TrustedApplication": 9
      },
      "properties": {
        "UserName": {
          "description": "The rule specifies a UserName from a UserNameIdentityToken.",
          "type": "integer"
        },
        "Thumbprint": {
          "description": "The rule specifies the Thumbprint of a user or CA Certificate.",
          "type": "integer"
        },
        "Role": {
          "description": "The rule is a Role specified in an Access Token.",
          "type": "integer"
        },
        "GroupId": {
          "description": "The rule is a user group specified in the Access Token.",
          "type": "integer"
        },
        "Anonymous": {
          "description": "The rule specifies Anonymous UserIdentityToken.",
          "type": "integer"
        },
        "AuthenticatedUser": {
          "description": "The rule specifies any non Anonymous UserIdentityToken.",
          "type": "integer"
        },
        "Application": {
          "description": "The rule specifies the combination of an application identity and an Anonymous UserIdentityToken.",
          "type": "integer"
        },
        "X509Subject": {
          "description": "The rule specifies the X509 subject name of a user or CA Certificate.",
          "type": "integer"
        },
        "TrustedApplication": {
          "description": "The rule specifies any trusted application that has been authenticated with a trusted ApplicationInstance Certificate.",
          "type": "integer"
        }
      }
    },
    "MessageSecurityMode": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MessageSecurityMode",
      "const": {
        "Invalid": 0,
        "None": 1,
        "Sign": 2,
        "SignAndEncrypt": 3
      },
      "properties": {
        "Invalid": {
          "type": "integer"
        },
        "None": {
          "type": "integer"
        },
        "Sign": {
          "type": "integer"
        },
        "SignAndEncrypt": {
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
    "/actions/AddApplication",
    "/actions/AddEndpoint",
    "/actions/AddIdentity",
    "/actions/RemoveApplication",
    "/actions/RemoveEndpoint",
    "/actions/RemoveIdentity",
    "/properties/Applications",
    "/properties/ApplicationsExclude",
    "/properties/CustomConfiguration",
    "/properties/Endpoints",
    "/properties/EndpointsExclude"
  ],
  "actions": {
    "AddApplication": {
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "ApplicationUri"
        ],
        "properties": {
          "ApplicationUri": {
            "type": "string"
          }
        }
      }
    },
    "AddEndpoint": {
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "Endpoint"
        ],
        "properties": {
          "Endpoint": {
            "title": "EndpointType",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.EndpointType",
            "required": [
              "EndpointUrl",
              "SecurityMode",
              "SecurityPolicyUri",
              "TransportProfileUri"
            ],
            "properties": {
              "EndpointUrl": {
                "type": "string"
              },
              "SecurityMode": {
                "title": "MessageSecurityMode",
                "dov:typeRef": "org.opcfoundation.UA.MessageSecurityMode",
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "SecurityPolicyUri": {
                "type": "string"
              },
              "TransportProfileUri": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "AddIdentity": {
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "Rule"
        ],
        "properties": {
          "Rule": {
            "title": "IdentityMappingRuleType",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.IdentityMappingRuleType",
            "required": [
              "CriteriaType",
              "Criteria"
            ],
            "properties": {
              "CriteriaType": {
                "title": "IdentityCriteriaType",
                "dov:typeRef": "org.opcfoundation.UA.IdentityCriteriaType",
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Criteria": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "RemoveApplication": {
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "ApplicationUri"
        ],
        "properties": {
          "ApplicationUri": {
            "type": "string"
          }
        }
      }
    },
    "RemoveEndpoint": {
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "Endpoint"
        ],
        "properties": {
          "Endpoint": {
            "title": "EndpointType",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.EndpointType",
            "required": [
              "EndpointUrl",
              "SecurityMode",
              "SecurityPolicyUri",
              "TransportProfileUri"
            ],
            "properties": {
              "EndpointUrl": {
                "type": "string"
              },
              "SecurityMode": {
                "title": "MessageSecurityMode",
                "dov:typeRef": "org.opcfoundation.UA.MessageSecurityMode",
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "SecurityPolicyUri": {
                "type": "string"
              },
              "TransportProfileUri": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "RemoveIdentity": {
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "Rule"
        ],
        "properties": {
          "Rule": {
            "title": "IdentityMappingRuleType",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.IdentityMappingRuleType",
            "required": [
              "CriteriaType",
              "Criteria"
            ],
            "properties": {
              "CriteriaType": {
                "title": "IdentityCriteriaType",
                "dov:typeRef": "org.opcfoundation.UA.IdentityCriteriaType",
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Criteria": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "Applications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": true
    },
    "ApplicationsExclude": {
      "type": "boolean",
      "readOnly": false
    },
    "CustomConfiguration": {
      "type": "boolean",
      "readOnly": true
    },
    "Endpoints": {
      "type": "array",
      "items": {
        "title": "EndpointType",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.EndpointType",
        "required": [
          "EndpointUrl",
          "SecurityMode",
          "SecurityPolicyUri",
          "TransportProfileUri"
        ],
        "properties": {
          "EndpointUrl": {
            "type": "string"
          },
          "SecurityMode": {
            "title": "MessageSecurityMode",
            "dov:typeRef": "org.opcfoundation.UA.MessageSecurityMode",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "SecurityPolicyUri": {
            "type": "string"
          },
          "TransportProfileUri": {
            "type": "string"
          }
        }
      },
      "readOnly": true
    },
    "EndpointsExclude": {
      "type": "boolean",
      "readOnly": false
    },
    "Identities": {
      "type": "array",
      "items": {
        "title": "IdentityMappingRuleType",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.IdentityMappingRuleType",
        "required": [
          "CriteriaType",
          "Criteria"
        ],
        "properties": {
          "CriteriaType": {
            "title": "IdentityCriteriaType",
            "dov:typeRef": "org.opcfoundation.UA.IdentityCriteriaType",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "Criteria": {
            "type": "string"
          }
        }
      },
      "readOnly": true
    }
  }
