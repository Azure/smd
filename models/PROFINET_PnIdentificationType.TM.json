        "LOCATION": 1,
        "BOTH": 2
      },
      "properties": {
        "FUNCTION": {
          "type": "integer"
        },
        "LOCATION": {
          "type": "integer"
        },
        "BOTH": {
          "type": "integer"
        }
      }
    }
  },
