          "description": "Warning, additive change is imminent. No need to stop the process.",
          "type": "integer"
        },
        "ERROR_EMPTY": {
          "description": "Error, the additive is empty. Production needs to be stopped.",
          "type": "integer"
        },
        "ERROR": {
          "description": "The additive has an error and process needs to be stopped.",
          "type": "integer"
        }
      }
    }
