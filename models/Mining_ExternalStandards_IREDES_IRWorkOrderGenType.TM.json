  "properties": {
    "AssignmentTime": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "title": "JobAssignmentTimeDataType",
      "description": "Time the execution of the job is expected to take.",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.Mining.ExternalStandards.IREDES.JobAssignmentTimeDataType",
      "properties": {
        "ExpectedFinishTime": {
          "description": "Time Machine is expected to finish the job.",
          "type": "string",
          "format": "date-time"
        },
        "ExpectedDuration": {
          "description": "Time the job is going to take to finish.",
          "type": "string",
          "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
        }
      },
      "readOnly": false
    },
    "Comment": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "DefaultInstanceBrowseName": {
      "type": "string",
      "readOnly": false
    },
    "Issuer": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "ID of the person or institute who issued this work order.",
      "type": "string",
      "readOnly": false
    },
    "MachineId": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "Machine assigned to the work.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "OperatorId": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "Operators assigned to the work.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "PriorityLevel": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "Priority of the workorder. Level from 1 to 10 as 10 representing top priority.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "readOnly": false
    },
    "SafetyAdvice": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "Work order shall be carried out. Schema should be defined separately within the IRoptionType.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "SpecialCondition": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "E.g. electricity will be switched off in some region in mine during operation.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "SpecialTask": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "Tasks that are not or hard to describe in workorder.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "WorkOrderId": {
      "dov:namespace": "http://opcfoundation.org/UA/Mining/ExternalStandards/IREDES",
      "description": "Identification of this work order. This ID has nothing to do with the, for example, work plan ID.",
