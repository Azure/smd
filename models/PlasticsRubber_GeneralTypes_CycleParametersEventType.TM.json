      "type": "string",
      "readOnly": true
    },
    "JobPartsCounter": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Total number of parts produced in the current job",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "readOnly": true
    },
    "JobStatus": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "title": "JobStatusEnumeration",
      "description": "Current status of the job",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.JobStatusEnumeration",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
