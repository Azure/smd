  "schemaDefinitions": {
    "InterfaceAdminStatus": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.InterfaceAdminStatus",
      "const": {
        "Up": 0,
        "Down": 1,
        "Testing": 2
      },
      "properties": {
        "Up": {
          "description": "Ready to pass packets.",
          "type": "integer"
        },
        "Down": {
          "description": "Not ready to pass packets and not in some test mode.",
          "type": "integer"
        },
        "Testing": {
          "description": "In some test mode.",
          "type": "integer"
        }
      }
    },
    "InterfaceOperStatus": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.InterfaceOperStatus",
      "const": {
        "Up": 0,
        "Down": 1,
        "Testing": 2,
        "Unknown": 3,
        "Dormant": 4,
        "NotPresent": 5,
        "LowerLayerDown": 6
      },
      "properties": {
        "Up": {
          "description": "Ready to pass packets.",
          "type": "integer"
        },
        "Down": {
          "description": "The interface does not pass any packets.",
          "type": "integer"
        },
        "Testing": {
          "description": "In some test mode. No operational packets can be passed.",
          "type": "integer"
        },
        "Unknown": {
          "description": "Status cannot be determined for some reason.",
          "type": "integer"
        },
        "Dormant": {
          "description": "Waiting for some external event.",
          "type": "integer"
        },
        "NotPresent": {
          "description": "Some component (typically hardware) is missing.",
          "type": "integer"
        },
        "LowerLayerDown": {
          "description": "Down due to state of lower-layer interface(s).",
          "type": "integer"
        }
      }
    }
  },
