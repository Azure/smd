  "schemaDefinitions": {
    "PnARStateEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnARStateEnumeration",
      "const": {
        "CONNECTED": 0,
        "UNCONNECTED": 1,
        "UNCONNECTED_ERR_DEVICE_NOT_FOUND": 2,
        "UNCONNECTED_ERR_DUPLICATE_IP": 3,
        "UNCONNECTED_ERR_DUPLICATE_NOS": 4
      },
      "properties": {
        "CONNECTED": {
          "description": "The AR connection to the device is established",
          "type": "integer"
        },
        "UNCONNECTED": {
          "description": "The AR connection to the device is not established",
          "type": "integer"
        },
        "UNCONNECTED_ERR_DEVICE_NOT_FOUND": {
          "description": "The AR connection to the device is not established because the device is not available in the network",
          "type": "integer"
        },
        "UNCONNECTED_ERR_DUPLICATE_IP": {
          "description": "The AR connection to the device is not established because the IP address of the device exists multiple times",
          "type": "integer"
        },
        "UNCONNECTED_ERR_DUPLICATE_NOS": {
          "description": "The AR connection to the device is not established because the Name of Station of the device exists multiple times",
          "type": "integer"
        }
      }
    },
    "PnARTypeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnARTypeEnumeration",
      "const": {
        "IOCARSingle": 0,
        "IOSAR": 6,
        "IOCARSingleUsingRT_CLASS_3": 16,
        "IOCARSR": 32
      },
      "properties": {
        "IOCARSingle": {
          "type": "integer"
        },
        "IOSAR": {
          "description": "The supervisor AR is a special form of the IOCARSingle allowing takeover of the ownership of a submodule",
          "type": "integer"
        },
        "IOCARSingleUsingRT_CLASS_3": {
          "description": "This is a special form of the IOCARSingle indicating RT_CLASS_3 communication",
          "type": "integer"
        },
        "IOCARSR": {
          "description": "The SR AR is a special form of the IOCARSingle indicating system redundancy or dynamic reconfiguration usage",
          "type": "integer"
        }
      }
    }
  },
