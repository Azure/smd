  "links": [],
  "schemaDefinitions": {
    "DeviceHealthEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.DI.DeviceHealthEnumeration",
      "const": {
        "NORMAL": 0,
        "FAILURE": 1,
        "CHECK_FUNCTION": 2,
        "OFF_SPEC": 3,
        "MAINTENANCE_REQUIRED": 4
      },
      "properties": {
        "NORMAL": {
          "description": "This device functions normally.",
          "type": "integer"
        },
        "FAILURE": {
          "description": "Malfunction of the device or any of its peripherals.",
          "type": "integer"
        },
        "CHECK_FUNCTION": {
          "description": "Functional checks are currently performed.",
          "type": "integer"
        },
        "OFF_SPEC": {
          "description": "The device is currently working outside of its specified range or that internal diagnoses indicate deviations from measured or set values.",
          "type": "integer"
        },
        "MAINTENANCE_REQUIRED": {
          "description": "This element is working, but a maintenance operation is required.",
          "type": "integer"
        }
      }
    }
  }
