          },
          "UnitId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "DisplayName": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "readOnly": true
    },
    "DefectPicture": {
      "dov:namespace": "http://opcfoundation.org/UA/TMC/v2/",
