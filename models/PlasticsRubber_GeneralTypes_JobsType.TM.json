  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/#PlasticsRubber_GeneralTypes_JobsType",
  "title": "PlasticsRubber_GeneralTypes_JobsType",
