  "schemaDefinitions": {
    "PnChannelAccumulativeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnChannelAccumulativeEnumeration",
      "const": {
        "SINGLE": 0,
        "ACCUMULATIVE": 256
      },
      "properties": {
        "SINGLE": {
          "description": "Single channel  Diagnosis only for the reported channel ",
          "type": "integer"
        },
        "ACCUMULATIVE": {
          "description": "Multiple channel  Accumulative diagnosis from more than one channel ",
          "type": "integer"
        }
      }
    },
    "PnChannelDirectionEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnChannelDirectionEnumeration",
      "const": {
        "MANUFACTURER_SPECIFIC": 0,
        "INPUT_CHANNEL": 8192,
        "OUTPUT_CHANNEL": 16384,
        "BIDIRECTIONAL_CHANNEL": 24576
      },
      "properties": {
        "MANUFACTURER_SPECIFIC": {
          "description": "Manufacturer specific",
          "type": "integer"
        },
        "INPUT_CHANNEL": {
          "description": "Input",
          "type": "integer"
        },
        "OUTPUT_CHANNEL": {
          "description": "Output",
          "type": "integer"
        },
        "BIDIRECTIONAL_CHANNEL": {
          "description": "Input/Output",
          "type": "integer"
        }
      }
    },
    "PnChannelMaintenanceEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnChannelMaintenanceEnumeration",
      "const": {
        "FAULT": 0,
        "MAINTENANCE_REQUIRED": 512,
        "MAINTENANCE_DEMANDED": 1024,
        "USE_QUALIFIED_CHANNEL_QUALIFIER": 1536
      },
      "properties": {
        "FAULT": {
          "description": "Fault",
          "type": "integer"
        },
        "MAINTENANCE_REQUIRED": {
          "description": "Maintenance required",
          "type": "integer"
        },
        "MAINTENANCE_DEMANDED": {
          "description": "Maintenance demanded",
          "type": "integer"
        },
        "USE_QUALIFIED_CHANNEL_QUALIFIER": {
          "description": "Use QualifiedChannelQualifier variable",
          "type": "integer"
        }
      }
    },
    "PnChannelSpecifierEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnChannelSpecifierEnumeration",
      "const": {
        "ALL_DISAPPEARS": 0,
        "APPEARS": 2048,
        "DISAPPEARS": 4096,
        "DISAPPEARS_OTHER_REMAIN": 6144
      },
      "properties": {
        "ALL_DISAPPEARS": {
          "description": "The Diagnosis ASE contains no longer any entries (of any severity) for this channel",
          "type": "integer"
        },
        "APPEARS": {
          "description": "An event appears and/or exists further The Diagnosis ASE contains this and possible other entries for this channel. ",
          "type": "integer"
        },
        "DISAPPEARS": {
          "description": "An event disappears and/or exists no longer The Diagnosis ASE contains no longer any entries of the same severity for this channel ",
          "type": "integer"
        },
        "DISAPPEARS_OTHER_REMAIN": {
          "description": "An event disappears The Diagnosis ASE still contains other entries of the same severity for this channel ",
          "type": "integer"
        }
      }
    },
    "PnChannelTypeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnChannelTypeEnumeration",
      "const": {
        "UNSPECIFIC": 0,
        "S1BIT": 1,
        "S2BIT": 2,
        "S4BIT": 3,
        "S8BIT": 4,
        "S16BIT": 5,
        "S32BIT": 6,
        "S64BIT": 7
      },
      "properties": {
        "UNSPECIFIC": {
          "description": "Shall be used if the field ChannelNumber contains the value 0x8000 (submodule) Furthermore, it shall be used if none of the below defined types are appropriate. ",
          "type": "integer"
        },
        "S1BIT": {
          "description": "The data length of this channel is 1 Bit.",
          "type": "integer"
        },
        "S2BIT": {
          "description": "The data length of this channel is 2 Bit.",
          "type": "integer"
        },
        "S4BIT": {
          "description": "The data length of this channel is 4 Bit.",
          "type": "integer"
        },
        "S8BIT": {
          "description": "The data length of this channel is 8 Bit.",
          "type": "integer"
        },
        "S16BIT": {
          "description": "The data length of this channel is 16 Bit.",
          "type": "integer"
        },
        "S32BIT": {
          "description": "The data length of this channel is 32 Bit.",
          "type": "integer"
        },
        "S64BIT": {
          "description": "The data length of this channel is 64 Bit.",
          "type": "integer"
        }
      }
    }
  },
