      "type": "string",
      "format": "time",
      "readOnly": false
    },
    "ServiceClass": {
      "dov:namespace": "http://opcfoundation.org/UA/MachineVision/AMCM/",
      "tm:ref": "#/schemaDefinitions/MultiStateDiscreteType",
      "readOnly": false
    },
    "StartOfWarranty": {
      "dov:namespace": "http://opcfoundation.org/UA/MachineVision/AMCM/",
      "description": "denotes the beginning of the warranty period of the item",
      "type": "string",
      "format": "time",
      "readOnly": false
