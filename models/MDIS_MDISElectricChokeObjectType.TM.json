{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/MDIS#MDIS_MDISElectricChokeObjectType",
  "title": "MDIS_MDISElectricChokeObjectType",
  "dov:typeRef": "org.opcfoundation.UA.MDIS.MDISElectricChokeObjectType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/MDIS#MDIS_MDISBaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "ChokeMoveEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.ChokeMoveEnum",
      "const": {
        "Moving": 1,
        "Stopped": 2
      },
      "properties": {
        "Moving": {
          "description": "The choke is currently moving (in progress)",
          "type": "integer"
        },
        "Stopped": {
          "description": "The move has stopped",
          "type": "integer"
        }
      }
    },
    "SEMEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
      "const": {
        "SEM_A": 1,
        "SEM_B": 2,
        "Auto": 4
      },
      "properties": {
        "SEM_A": {
          "description": "Valve move command selection SEM A",
          "type": "integer"
        },
        "SEM_B": {
          "description": "Valve move command selection SEM B",
          "type": "integer"
        },
        "Auto": {
          "description": "Subsea equipment vendor decides how to send the command. In some cases, this would be both SEMs, in others it would mean a subsea system’s choice of a SEM.",
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
    "/properties/CommandRejected",
    "/properties/DefeatableCloseInterlock",
    "/properties/DefeatableOpenInterlock",
    "/properties/NonDefeatableCloseInterlock",
    "/properties/NonDefeatableOpenInterlock",
    "/events/CommandRejected",
    "/events/DefeatableCloseInterlock",
    "/events/DefeatableOpenInterlock",
    "/events/NonDefeatableCloseInterlock",
    "/events/NonDefeatableOpenInterlock"
  ],
  "actions": {
    "Abort": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS"
    },
    "Move": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "Position",
          "OverrideInterlocks",
          "SEM"
        ],
        "properties": {
          "Position": {
            "description": "A number (in percent) indicating the percent open",
            "type": "number",
            "minimum": -3.40e+38,
            "maximum": 3.40e+38
          },
          "OverrideInterlocks": {
            "description": "Boolean indicating if the open or close command should override any defeat able interlocks",
            "type": "boolean"
          },
          "SEM": {
            "title": "SEMEnum",
            "description": "The selection of which SEM to send the command to",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      }
    }
  },
  "properties": {
    "ActualPosition": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "type": "number",
      "minimum": -3.40e+38,
      "maximum": 3.40e+38,
      "readOnly": true
    },
    "CommandRejected": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "type": "boolean",
      "readOnly": true
    },
    "DefeatableCloseInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "type": "boolean",
      "readOnly": true
    },
    "DefeatableOpenInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "type": "boolean",
      "readOnly": true
    },
    "Moving": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "title": "ChokeMoveEnum",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.ChokeMoveEnum",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "readOnly": true
    },
    "NonDefeatableCloseInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "type": "boolean",
      "readOnly": true
    },
    "NonDefeatableOpenInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "type": "boolean",
      "readOnly": true
    }
  },
  "events": {
    "ActualPosition": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "type": "number",
        "minimum": -3.40e+38,
        "maximum": 3.40e+38
      }
    },
    "CommandRejected": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "type": "boolean"
      }
    },
    "DefeatableCloseInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "type": "boolean"
      }
    },
    "DefeatableOpenInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "type": "boolean"
      }
    },
    "Moving": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "title": "ChokeMoveEnum",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.ChokeMoveEnum",
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      }
    },
    "NonDefeatableCloseInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "type": "boolean"
      }
    },
    "NonDefeatableOpenInterlock": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "data": {
        "type": "boolean"
      }
    }
  }
}