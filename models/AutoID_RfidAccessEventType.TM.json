                "required": [
                  "PC",
                  "UId",
                  "XPC_W1",
                  "XPC_W2"
                ],
                "properties": {
                  "PC": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "UId": {
                    "type": "string",
                    "contentEncoding": "base64"
                  },
                  "XPC_W1": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "XPC_W2": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                }
