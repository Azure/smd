  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.TMC.v2.ExternalAlarmType",
  "title": "TMC_v2_ExternalAlarmType",
  "dov:typeRef": "org.opcfoundation.UA.TMC.v2.ExternalAlarmType",
  "dov:isEvent": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.DiscreteAlarmType",
      "type": "application/tm+json"
    }
  ],
  "actions": {
    "SetMessage": {
      "dov:namespace": "http://opcfoundation.org/UA/TMC/v2/",
      "description": "The Method SetMessage sets the Message that the underlying system will display for the alarm.",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.TMC.v2.InputArguments",
        "required": [
          "Message"
        ],
        "properties": {
          "Message": {
            "description": "The message that will be displayed for the external alarm.",
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.TMC.v2.OutputArguments",
        "required": [
          "ExecutionFeedback"
        ],
        "properties": {
          "ExecutionFeedback": {
            "title": "MethodExecutionFeedbackType",
            "description": "The MethodExecutionFeedbackType provides suitable feedback, both positive and negative, to an OPC UA client invoking a method.",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.TMC.v2.MethodExecutionFeedbackType",
            "required": [
              "Success",
              "Message"
            ],
            "properties": {
              "Success": {
                "description": "Returns True in case of successful execution.",
                "type": "boolean"
              },
              "Message": {
                "description": "Array of detailed messages describing the reason for the unsuccessful execution or notice to the user.",
                "type": "array",
                "items": {
                  "title": "MessageType",
                  "description": "The MessageType provides a uniquely identified localised text.",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.TMC.v2.MessageType",
                  "required": [
                    "ID",
                    "LocalText"
                  ],
                  "properties": {
                    "ID": {
                      "description": "Unique identifier for the localised text.",
                      "type": "string"
                    },
                    "LocalText": {
                      "description": "The localized text.",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "ExternalAlarmCondition": {
      "dov:namespace": "http://opcfoundation.org/UA/TMC/v2/",
      "description": "The condition that causes the alarm.",
      "type": "boolean",
      "readOnly": false
    }
  }
