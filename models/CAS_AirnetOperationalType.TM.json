  ],
  "schemaDefinitions": {
    "AirnetHealthStateEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.CAS.AirnetHealthStateEnum",
      "const": {
        "OK": 0,
        "Warning": 1,
        "Error": 2,
        "Critical": 3
      },
      "properties": {
        "OK": {
          "description": "All requirements can be fulfilled.",
          "type": "integer"
        },
        "Warning": {
          "description": "Check required, possibly there is a problem that leads to an Error.",
          "type": "integer"
        },
        "Error": {
          "description": "Immediate action needed to avoid Critical.",
          "type": "integer"
        },
        "Critical": {
          "description": "At least one requirement cannot be fulfilled.",
          "type": "integer"
        }
      }
    },
    "AirnetIntegratedStateEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.CAS.AirnetIntegratedStateEnum",
      "const": {
        "FullyIntegrated": 0,
        "PartiallyIntegrated": 1,
        "FullyIsolated": 2
      },
      "properties": {
        "FullyIntegrated": {
          "description": "The MCS controls all compressors of this airnet.",
          "type": "integer"
        },
        "PartiallyIntegrated": {
          "description": "At least one compressor of this airnet is not controlled by the MCS.",
          "type": "integer"
        },
        "FullyIsolated": {
          "description": "The MCS does not control any compressor of this airnet.",
          "type": "integer"
        }
      }
    },
    "AirnetOperatingStateEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.CAS.AirnetOperatingStateEnum",
      "const": {
        "Other": 0,
        "Stopped": 1,
        "Starting": 2,
        "Stopping": 3,
        "Operational": 4
      },
      "properties": {
        "Other": {
          "description": "The airnet is in a state not specified by this enumeration.",
          "type": "integer"
        },
        "Stopped": {
          "description": "The requirements shall not be fulfilled.",
          "type": "integer"
        },
        "Starting": {
          "description": "Transition phase to end in Operational state.",
          "type": "integer"
        },
        "Stopping": {
          "description": "Transition phase to end in Stopped state.",
          "type": "integer"
        },
        "Operational": {
          "description": "The requirements should be fulfilled.",
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
