          "ReturnCode"
        ],
        "properties": {
          "CurrentTimeToOperate": {
            "description": "Time needed to reach PE_ready_to_operate if successful, otherwise unchanged.",
            "type": "string",
            "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
          },
          "ReturnCode": {
            "description": "Return code.",
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "StartPause": {
      "dov:namespace": "http://opcfoundation.org/UA/ECM/",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.ECM.InputArguments",
