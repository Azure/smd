  "schemaDefinitions": {
    "CIMVMoveEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.CIMVMoveEnum",
      "const": {
        "MoveClose": 1,
        "MoveOpen": 2,
        "Stop": 4
      },
      "properties": {
        "MoveClose": {
          "description": "The CIMV is moving in the close direction",
          "type": "integer"
        },
        "MoveOpen": {
          "description": "The CIMV is moving in the open direction",
          "type": "integer"
        },
        "Stop": {
          "description": "The CIMV is not moving",
          "type": "integer"
        }
      }
    },
    "CIMVOperationModeEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.CIMVOperationModeEnum",
      "const": {
        "Position": 1,
        "Flow": 2,
        "Manual": 4
      },
      "properties": {
        "Position": {
          "description": "The CIMV is in closed-loop Position control mode. Sending fix position",
          "type": "integer"
        },
        "Flow": {
          "description": "The CIMV is in closed-loop Flow control mode (auto regulate)",
          "type": "integer"
        },
        "Manual": {
          "description": "The CIMV is in open-loop Manual mode (compare it to step mode – i.e., move some increment relative to current). Note: some CIMV instance may not support this mode.",
          "type": "integer"
        }
      }
    },
    "SEMEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
      "const": {
        "SEM_A": 1,
        "SEM_B": 2,
        "Auto": 4
      },
      "properties": {
        "SEM_A": {
          "description": "Valve move command selection SEM A",
          "type": "integer"
        },
        "SEM_B": {
          "description": "Valve move command selection SEM B",
          "type": "integer"
        },
        "Auto": {
          "description": "Subsea equipment vendor decides how to send the command. In some cases, this would be both SEMs, in others it would mean a subsea system’s choice of a SEM.",
          "type": "integer"
        }
      }
    }
  },
