{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.DI.PackageMetadata.Assignment",
  "title": "DI_PackageMetadata_Assignment",
  "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.Assignment",
  "links": [],
  "schemaDefinitions": {
    "Assignment": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.Assignment",
      "required": [
