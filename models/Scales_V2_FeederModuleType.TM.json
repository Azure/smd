            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.EUInformation",
            "required": [
              "NamespaceUri",
              "UnitId",
              "DisplayName",
              "Description"
            ],
            "properties": {
              "NamespaceUri": {
                "type": "string"
              },
              "UnitId": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "DisplayName": {
                "type": "string"
              },
              "Description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
