  "schemaDefinitions": {
    "MaintenanceLevelEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.Pumps.MaintenanceLevelEnum",
      "const": {
        "Level1": 0,
        "Level2": 1,
        "Level3": 2,
        "Level4": 3,
        "Level5": 4
      },
      "description": "defines maintenance levels for the pump",
      "properties": {
        "Level1": {
          "description": "Level 1 is characterized by simple actions carried out with minimal training",
          "type": "integer"
        },
        "Level2": {
          "description": "Level 2 is characterized by basic actions which have to be carried out by qualified personnel using detailed procedures ",
          "type": "integer"
        },
        "Level3": {
          "description": "Level 3 is characterized by complex actions carried out by qualified technical personnel using detailed procedures",
          "type": "integer"
        },
        "Level4": {
          "description": "Level 4 is characterized by actions which imply the know-how of a technique or a technology and carried out by specialized technical personnel",
          "type": "integer"
        },
        "Level5": {
          "description": "Level 5 is characterized by actions which imply a knowledge held by the manufacturer or a specialized company with industrial logistic support equipment",
          "type": "integer"
        }
      }
    },
    "StateOfTheItemEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.Pumps.StateOfTheItemEnum",
      "const": {
        "IdleState": 0,
        "StandByState": 1,
        "OperatingState": 2,
        "ExternalDisabledState": 3,
        "DownState": 4
      },
      "description": "describes the state of the pump",
      "properties": {
        "IdleState": {
          "description": "Item is in up state and non-operating outside required time",
          "type": "integer"
        },
        "StandByState": {
          "description": "Item is in up state and non-operating during required time",
          "type": "integer"
        },
        "OperatingState": {
          "description": "Item is in up state and operating as required",
          "type": "integer"
        },
        "ExternalDisabledState": {
          "description": "Item is in up state, but lacks required external resources or is disabled due to planned actions other than maintenance",
          "type": "integer"
        },
        "DownState": {
          "description": "Item is unable to perform a required function due to preventive maintenance or a fault",
          "type": "integer"
        }
      }
    },
    "TwoStateDiscreteType": {
      "dov:typeRef": "org.opcfoundation.UA.TwoStateDiscreteType",
      "type": "boolean"
    }
  },
