  "links": [],
  "schemaDefinitions": {
    "LevelDisplayMode": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.IA.LevelDisplayMode",
      "const": {
        "Dimmed": 0,
        "Blinking": 1,
        "Other": 2
      },
      "description": "Contains the values used to indicate how a percentual value is displayed if the stacklight unit works in Levelmeter mode.",
      "properties": {
        "Dimmed": {
          "description": "Uses dimming to display fractions.",
          "type": "integer"
        },
        "Blinking": {
          "description": "Uses blinking to display fractions.",
          "type": "integer"
        },
        "Other": {
          "description": "Display fractions in a way not defined in this version of the specification.",
          "type": "integer"
        }
      }
    }
  }
