  "schemaDefinitions": {
    "AutoIdOperationStatusEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.AutoID.AutoIdOperationStatusEnumeration",
      "const": {
        "SUCCESS": 0,
        "MISC_ERROR_TOTAL": 1,
        "MISC_ERROR_PARTIAL": 2,
        "PERMISSON_ERROR": 3,
        "PASSWORD_ERROR": 4,
        "REGION_NOT_FOUND_ERROR": 5,
        "OP_NOT_POSSIBLE_ERROR": 6,
        "OUT_OF_RANGE_ERROR": 7,
        "NO_IDENTIFIER": 8,
        "MULTIPLE_IDENTIFIERS": 9,
        "READ_ERROR": 10,
        "DECODING_ERROR": 11,
        "MATCH_ERROR": 12,
        "CODE_NOT_SUPPORTED": 13,
        "WRITE_ERROR": 14,
        "NOT_SUPPORTED_BY_DEVICE": 15,
        "NOT_SUPPORTED_BY_TAG": 16,
        "DEVICE_NOT_READY": 17,
        "INVALID_CONFIGURATION": 18,
        "RF_COMMUNICATION_ERROR": 19,
        "DEVICE_FAULT": 20,
        "TAG_HAS_LOW_BATTERY": 21
      },
      "properties": {
        "SUCCESS": {
          "description": "Successful operation",
          "type": "integer"
        },
        "MISC_ERROR_TOTAL": {
          "description": "The operation has not be executed in total.",
          "type": "integer"
        },
        "MISC_ERROR_PARTIAL": {
          "description": "The operation has been executed only partial.",
          "type": "integer"
        },
        "PERMISSON_ERROR": {
          "description": "Password required",
          "type": "integer"
        },
        "PASSWORD_ERROR": {
          "description": "Password is wrong.",
          "type": "integer"
        },
        "REGION_NOT_FOUND_ERROR": {
          "description": "Memory region not available for the actual tag.",
          "type": "integer"
        },
        "OP_NOT_POSSIBLE_ERROR": {
          "description": "Operation not supported by the actual tag.",
          "type": "integer"
        },
        "OUT_OF_RANGE_ERROR": {
          "description": "Addressed memory not available for the actual tag.",
          "type": "integer"
        },
        "NO_IDENTIFIER": {
          "description": "The operation cannot be executed because no tag or code was inside the range of the AutoID Device or the tag or code has been moved out of the range during execution.",
          "type": "integer"
        },
        "MULTIPLE_IDENTIFIERS": {
          "description": "Multiple tags or codes have been selected, but the command can only be used with a single tag or code.",
          "type": "integer"
        },
        "READ_ERROR": {
          "description": "The tag or code exists and has a valid format, but there was a problem reading the data (e.g. still CRC error after maximum number of retries).",
          "type": "integer"
        },
        "DECODING_ERROR": {
          "description": "The (optical) code or plain text has too many failures and cannot be detected.",
          "type": "integer"
        },
        "MATCH_ERROR": {
          "description": "The code doesn’t match the given target value.",
          "type": "integer"
        },
        "CODE_NOT_SUPPORTED": {
          "description": "The code format is not supported by the AutoID Device.",
          "type": "integer"
        },
        "WRITE_ERROR": {
          "description": "The tag exists, but there was a problem writing the data.",
          "type": "integer"
        },
        "NOT_SUPPORTED_BY_DEVICE": {
          "description": "The command or a parameter combination is not supported by the AutoID Device.",
          "type": "integer"
        },
        "NOT_SUPPORTED_BY_TAG": {
          "description": "The command or a parameter combination is not supported by the tag.",
          "type": "integer"
        },
        "DEVICE_NOT_READY": {
          "description": "The AutoID Device is in a state not ready to execute the command.",
          "type": "integer"
        },
        "INVALID_CONFIGURATION": {
          "description": "The AutoID Device configuration is not valid.",
          "type": "integer"
        },
        "RF_COMMUNICATION_ERROR": {
          "description": "This error indicates that there is a general error in the communication between the transponder and the reader.",
          "type": "integer"
        },
        "DEVICE_FAULT": {
          "description": "The AutoID Device has a hardware fault.",
          "type": "integer"
        },
        "TAG_HAS_LOW_BATTERY": {
          "description": "The battery of the (active) tag is low.",
          "type": "integer"
        }
      }
    },
