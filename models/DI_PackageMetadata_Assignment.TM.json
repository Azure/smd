        "Targets"
      ],
      "properties": {
        "Subpackage": {
          "type": "string"
        },
        "InstallationOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "Targets": {
          "type": "array",
          "items": {
            "title": "PackageTarget",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.PackageTarget",
            "properties": {
              "TargetType": {
                "type": "string"
              },
              "TargetNode": {
                "type": "string"
              },
              "ProductInstanceUri": {
                "type": "string"
              },
              "AssetId": {
                "type": "string"
              },
              "ManufacturerUri": {
                "type": "string"
              },
              "ProductCode": {
                "type": "string"
              },
              "SerialNumber": {
                "type": "string"
              },
              "FxPath": {
                "type": "array",
                "items": {
                  "title": "FxPathElement",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.FxPathElement",
                  "required": [
                    "AssetConnectorType"
                  ],
                  "properties": {
                    "AssetConnectorType": {
                      "type": "string"
                    },
                    "ConnectorId": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "ConnectorName": {
                      "type": "string"
                    }
                  }
                }
              },
              "FxScope": {
                "type": "array",
                "items": {
                  "title": "FxPathElement",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.DI.PackageMetadata.FxPathElement",
                  "required": [
                    "AssetConnectorType"
                  ],
