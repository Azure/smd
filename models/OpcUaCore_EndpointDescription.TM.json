{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.EndpointDescription",
  "title": "OpcUaCore_EndpointDescription",
  "dov:typeRef": "org.opcfoundation.UA.EndpointDescription",
  "links": [],
  "schemaDefinitions": {
    "EndpointDescription": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.EndpointDescription",
      "required": [
        "EndpointUrl",
        "Server",
        "ServerCertificate",
        "SecurityMode",
        "SecurityPolicyUri",
        "UserIdentityTokens",
        "TransportProfileUri",
        "SecurityLevel"
      ],
      "properties": {
        "EndpointUrl": {
          "type": "string"
        },
        "Server": {
          "title": "ApplicationDescription",
          "type": "object",
          "dov:typeRef": "org.opcfoundation.UA.ApplicationDescription",
          "required": [
            "ApplicationUri",
            "ProductUri",
            "ApplicationName",
            "ApplicationType",
            "GatewayServerUri",
            "DiscoveryProfileUri",
            "DiscoveryUrls"
          ],
          "properties": {
            "ApplicationUri": {
              "type": "string"
            },
            "ProductUri": {
              "type": "string"
            },
            "ApplicationName": {
              "type": "string"
            },
            "ApplicationType": {
              "title": "ApplicationType",
              "dov:typeRef": "org.opcfoundation.UA.ApplicationType",
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "GatewayServerUri": {
              "type": "string"
            },
            "DiscoveryProfileUri": {
              "type": "string"
            },
            "DiscoveryUrls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ServerCertificate": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "SecurityMode": {
          "title": "MessageSecurityMode",
          "dov:typeRef": "org.opcfoundation.UA.MessageSecurityMode",
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "SecurityPolicyUri": {
          "type": "string"
        },
        "UserIdentityTokens": {
          "type": "array",
          "items": {
            "title": "UserTokenPolicy",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.UserTokenPolicy",
            "required": [
              "PolicyId",
              "TokenType",
              "IssuedTokenType",
              "IssuerEndpointUrl",
              "SecurityPolicyUri"
            ],
            "properties": {
              "PolicyId": {
                "type": "string"
              },
              "TokenType": {
                "title": "UserTokenType",
                "dov:typeRef": "org.opcfoundation.UA.UserTokenType",
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "IssuedTokenType": {
                "type": "string"
              },
              "IssuerEndpointUrl": {
                "type": "string"
              },
              "SecurityPolicyUri": {
                "type": "string"
              }
            }
          }
        },
        "TransportProfileUri": {
          "type": "string"
        },
        "SecurityLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}