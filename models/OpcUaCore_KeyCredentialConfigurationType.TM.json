  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/#OpcUaCore_KeyCredentialConfigurationType",
  "title": "OpcUaCore_KeyCredentialConfigurationType",
  "dov:typeRef": "org.opcfoundation.UA.KeyCredentialConfigurationType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/#OpcUaCore_BaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/actions/DeleteCredential",
    "/actions/GetEncryptingKey",
    "/actions/UpdateCredential",
    "/properties/CredentialId",
    "/properties/EndpointUrls",
    "/properties/ServiceStatus"
  ],
  "actions": {
    "DeleteCredential": {},
