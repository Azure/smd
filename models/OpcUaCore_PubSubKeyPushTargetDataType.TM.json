{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/#OpcUaCore_PubSubKeyPushTargetDataType",
  "title": "OpcUaCore_PubSubKeyPushTargetDataType",
  "dov:typeRef": "org.opcfoundation.UA.PubSubKeyPushTargetDataType",
  "links": [],
  "schemaDefinitions": {
    "PubSubKeyPushTargetDataType": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PubSubKeyPushTargetDataType",
      "required": [
        "ApplicationUri",
        "PushTargetFolder",
        "EndpointUrl",
        "SecurityPolicyUri",
        "UserTokenType",
        "RequestedKeyCount",
        "RetryInterval",
        "PushTargetProperties",
        "SecurityGroups"
      ],
      "properties": {
        "ApplicationUri": {
          "type": "string"
        },
        "PushTargetFolder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "EndpointUrl": {
          "type": "string"
        },
        "SecurityPolicyUri": {
          "type": "string"
        },
        "UserTokenType": {
          "title": "UserTokenPolicy",
          "type": "object",
          "dov:typeRef": "org.opcfoundation.UA.UserTokenPolicy",
          "required": [
            "PolicyId",
            "TokenType",
            "IssuedTokenType",
            "IssuerEndpointUrl",
            "SecurityPolicyUri"
          ],
          "properties": {
            "PolicyId": {
              "type": "string"
            },
            "TokenType": {
              "title": "UserTokenType",
              "dov:typeRef": "org.opcfoundation.UA.UserTokenType",
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "IssuedTokenType": {
              "type": "string"
            },
            "IssuerEndpointUrl": {
              "type": "string"
            },
            "SecurityPolicyUri": {
              "type": "string"
            }
          }
        },
        "RequestedKeyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "RetryInterval": {
          "type": "string",
          "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
        },
        "PushTargetProperties": {
          "type": "array",
          "items": {
            "title": "KeyValuePair",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.KeyValuePair",
            "required": [
              "Key",
              "Value"
            ],
            "properties": {
              "Key": {
                "type": "string"
              },
              "Value": {
                "description": "Stand-in for an unspecified data type.",
                "type": "string"
              }
            }
          }
        },
        "SecurityGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}