                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "ConnectorName": {
                      "type": "string"
                    }
                  }
                }
              },
              "BrowsePath": {
                "type": "array",
                "items": {
                  "title": "RelativePathElement",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.RelativePathElement",
