  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.MDIS.MDISChokeObjectType",
  "title": "MDIS_MDISChokeObjectType",
  "dov:typeRef": "org.opcfoundation.UA.MDIS.MDISChokeObjectType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.MDIS.MDISBaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "ChokeCommandEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.ChokeCommandEnum",
      "const": {
        "Close": 1,
        "Open": 2
      },
      "properties": {
        "Close": {
          "description": "The command to the Choke is Close",
          "type": "integer"
        },
        "Open": {
          "description": "The command to the Choke is Open",
          "type": "integer"
        }
      }
    },
    "ChokeMoveEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.ChokeMoveEnum",
      "const": {
        "Moving": 1,
        "Stopped": 2
      },
      "properties": {
        "Moving": {
          "description": "The choke is currently moving (in progress)",
          "type": "integer"
        },
        "Stopped": {
          "description": "The move has stopped",
          "type": "integer"
        }
      }
    },
    "SEMEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
      "const": {
        "SEM_A": 1,
        "SEM_B": 2,
        "Auto": 4
      },
      "properties": {
        "SEM_A": {
          "description": "Valve move command selection SEM A",
          "type": "integer"
        },
        "SEM_B": {
          "description": "Valve move command selection SEM B",
          "type": "integer"
        },
        "Auto": {
          "description": "Subsea equipment vendor decides how to send the command. In some cases, this would be both SEMs, in others it would mean a subsea system’s choice of a SEM.",
          "type": "integer"
        }
      }
    },
    "SetCalculatedPositionEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MDIS.SetCalculatedPositionEnum",
      "const": {
        "Initial": 0,
        "Inprogress": 1,
        "Complete": 2,
        "Fault": 4
      },
      "properties": {
        "Initial": {
          "description": "no command (initial state)",
          "type": "integer"
        },
        "Inprogress": {
          "description": "command in progress",
          "type": "integer"
        },
        "Complete": {
          "description": "command completed",
          "type": "integer"
        },
        "Fault": {
          "description": "command fault",
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
    "/actions/Step",
    "/properties/CommandRejected",
    "/properties/DefeatableCloseInterlock",
