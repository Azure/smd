  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.PNENC.EncoderDiagnosisEventType",
  "title": "PNENC_EncoderDiagnosisEventType",
  "dov:typeRef": "org.opcfoundation.UA.PNENC.EncoderDiagnosisEventType",
  "dov:isEvent": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.BaseEventType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "EncoderDiagnosisReasonEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNENC.EncoderDiagnosisReasonEnumeration",
      "const": {
        "ALL_DISAPPEARS": 0,
        "APPEARS": 1,
        "DISAPPEARS": 2,
        "DISAPPEARS_OTHER_REMAIN": 3
      },
      "properties": {
        "ALL_DISAPPEARS": {
          "description": "No diagnosis condition of any severity is persisting",
          "type": "integer"
        },
        "APPEARS": {
          "description": "The diagnosis condition indicated arises and/or persists",
          "type": "integer"
        },
        "DISAPPEARS": {
          "description": "The diagnosis condition indicated does not longer persist. No diagnosis condition of the same severity is persisting for the affected channel",
          "type": "integer"
        },
        "DISAPPEARS_OTHER_REMAIN": {
          "description": "The diagnosis condition indicated does not longer persist. Other diagnosis conditions of the same severity are persisting",
          "type": "integer"
        }
      }
    },
    "EventTypeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNENC.EventTypeEnumeration",
      "const": {
        "FAULT": 0,
        "WARNING": 1,
        "UNSPECIFIED": 255
      },
      "properties": {
        "FAULT": {
          "description": "The log entry indicates a malfunction of the encoder, e.g. position fault",
          "type": "integer"
        },
        "WARNING": {
          "description": "The log entry is a warning, e.g. for battery status",
          "type": "integer"
        },
        "UNSPECIFIED": {
          "description": "No information about the type of the event is given.  The intended purpose for the definition is usage by the GetFilteredLogbookEntries Method to specify “don’t care” for the EventType parameter. Must not be used for log entries and encoder diagnosis events as EncoderDiagnosisEventType and LogbookEventType",
          "type": "integer"
        }
      }
    }
  },
  "properties": {
    "DiagnosisType": {
      "dov:namespace": "http://opcfoundation.org/UA/PNENC/",
