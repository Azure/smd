                    "IsInverse": {
                      "type": "boolean"
                    },
                    "IncludeSubtypes": {
                      "type": "boolean"
                    },
                    "TargetName": {
                      "type": "string"
                    }
                  }
                }
              },
              "TargetServer": {
                "type": "string"
              }
            }
          }
