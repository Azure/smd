  "id": "http://opcfoundation.org/UA/#OpcUaCore_LldpRemoteSystemType",
  "title": "OpcUaCore_LldpRemoteSystemType",
  "dov:typeRef": "org.opcfoundation.UA.LldpRemoteSystemType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/#OpcUaCore_BaseObjectType",
