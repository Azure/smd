    "EDMGeneratorState": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MachineTool.EDMGeneratorState",
      "const": {
        "Undefined": 0,
        "Ready": 1,
        "Active_Low_Voltage": 2,
        "Active_High_Voltage": 3,
        "Error": 4
      },
      "properties": {
        "Undefined": {
          "description": "The EDM spark generator state cannot be indicated.",
          "type": "integer"
        },
        "Ready": {
          "description": "Generator is initialized and can receive a set of technology parameters.",
          "type": "integer"
        },
        "Active_Low_Voltage": {
          "description": "Generator is switched on and is supplying pulses respecting the low voltage (≤ 25 V AC or ≤ 60 V DC) requirements of safety standard (ISO 28881).",
          "type": "integer"
        },
        "Active_High_Voltage": {
          "description": "Generator is switched on and is supplying pulse at high voltage (> 25 V AC or > 60 V DC).",
          "type": "integer"
        },
        "Error": {
          "description": "Generator is in an error state.",
          "type": "integer"
        }
      }
