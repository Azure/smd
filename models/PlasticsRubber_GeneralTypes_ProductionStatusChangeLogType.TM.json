  "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.ProductionStatusChangeLogType",
  "dov:isEvent": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.PlasticsRubber.GeneralTypes.LogbookEventType",
