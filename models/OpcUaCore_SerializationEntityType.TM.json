              "title": "KeyValuePair",
              "type": "object",
              "dov:typeRef": "org.opcfoundation.UA.KeyValuePair",
              "required": [
                "Key",
                "Value"
              ],
              "properties": {
                "Key": {
                  "type": "string"
                },
                "Value": {
                  "description": "Stand-in for an unspecified data type.",
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.OutputArguments",
        "required": [
          "Results"
        ],
        "properties": {
          "Results": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          }
        }
      }
    }
  },
  "properties": {
    "ConsiderSubElementSerializationProperties": {
      "type": "boolean",
      "readOnly": true
    },
    "CustomMetaDataProperties": {
      "type": "array",
      "items": {
        "title": "KeyValuePair",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.KeyValuePair",
