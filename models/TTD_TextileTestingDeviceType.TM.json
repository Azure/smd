  "properties": {
    "AvailableExchangeableParts": {
      "dov:namespace": "http://opcfoundation.org/UA/TTD/",
      "type": "array",
      "items": {
        "title": "ExchangeablePartDataType",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.TTD.ExchangeablePartDataType",
        "required": [
          "PartType",
          "Mounted"
        ],
        "properties": {
          "PartType": {
            "description": "Name of the machine part.",
            "type": "string"
          },
          "Mounted": {
            "description": "Flag stating if the part is currently mounted or not.",
            "type": "boolean"
          },
          "Traceable": {
            "description": "Flag stating if the part is traceable (e.g. has an id or serial number).",
            "type": "boolean"
          },
          "PartId": {
            "description": "Id or serial number of the part.",
            "type": "string"
          },
          "MachineReadable": {
            "description": "Flag stating if the PartId is machine readable.",
            "type": "boolean"
          },
          "LastCalibrationDate": {
            "description": "Date of the last calibration of this part if available.",
            "type": "string",
            "format": "time"
          }
        }
      },
      "readOnly": false
    },
    "InstalledTesterModules": {
      "dov:namespace": "http://opcfoundation.org/UA/TTD/",
      "type": "array",
      "items": {
        "title": "OptionalModuleDataType",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.TTD.OptionalModuleDataType",
        "required": [
          "ModuleName",
          "ModuleType",
          "IsInstalled"
        ],
        "properties": {
          "ModuleName": {
            "description": "The name of the module.",
            "type": "string"
          },
          "ModuleType": {
            "description": "The type of the module. E.g. hardware/software.",
            "type": "string"
          },
          "IsInstalled": {
            "description": "Flag that indicates if the module is installed.",
            "type": "boolean"
          },
          "Version": {
            "description": "Version of the soft-/hardware module.",
            "type": "string"
          }
        }
      },
      "readOnly": false
    },
    "TestProcedureIds": {
      "dov:namespace": "http://opcfoundation.org/UA/TTD/",
      "type": "array",
      "items": {
        "title": "TestProcedureIdDataType",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.TTD.TestProcedureIdDataType",
        "required": [
          "TestProcedureId"
        ],
        "properties": {
          "TestProcedureId": {
            "description": "The available test procedures are stored on the testing device and referenced by name (TestProcedureId).",
            "type": "string"
          },
          "Description": {
            "description": "Description of the test procedure.",
            "type": "string"
          },
          "ProcedureReferences": {
            "description": "An array of references to standards.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "IsProcedureLicensed": {
            "description": "Flag to define the availability on the server.",
            "type": "boolean"
          }
        }
      },
      "readOnly": false
    }
  }
