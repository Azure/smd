    "CustomMetaDataRef": {
      "type": "string",
      "readOnly": true
    },
    "ExcludeReferenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": true
    },
    "IncludeDictionaryReference": {
      "type": "boolean",
      "readOnly": true
    },
    "IncludeReferenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": true
    },
    "IncludeSourceTimestamp": {
      "type": "boolean",
      "readOnly": true
    },
    "IncludeStatus": {
      "type": "boolean",
      "readOnly": true
    },
    "SerializationDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "readOnly": true
    },
    "SerializedData": {
      "type": "string",
      "readOnly": true
    }
  },
  "events": {
    "SerializedData": {
      "data": {
        "type": "string"
      }
    }
  }
