  "schemaDefinitions": {
    "ControlModeEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PAEFS.ControlModeEnum",
      "const": {
        "Automatic": 0,
        "Manual": 1,
        "Other": 2
      },
      "description": "Describes the possibility of controlling the system externally",
      "properties": {
        "Automatic": {
          "type": "integer"
        },
        "Manual": {
          "type": "integer"
        },
        "Other": {
          "type": "integer"
        }
      }
    }
