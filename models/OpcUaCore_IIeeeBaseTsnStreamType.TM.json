  "id": "urn:org.opcfoundation.UA.IIeeeBaseTsnStreamType",
  "title": "OpcUaCore_IIeeeBaseTsnStreamType",
  "dov:typeRef": "org.opcfoundation.UA.IIeeeBaseTsnStreamType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.BaseInterfaceType",
