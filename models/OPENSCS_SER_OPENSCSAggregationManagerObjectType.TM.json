    "OPENSCSReturnEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.OPENSCS-SER.OPENSCSReturnEnum",
      "const": {
        "Undefined0": 0,
        "NoError1": 1,
        "InvalidSerialNumberCollection2": 2,
        "InsufficientSerialNumbers3": 3,
        "InvalidSerialNumbersFormat4": 4,
        "InvalidRequestToken5": 5,
        "InvalidSelectionCriteria6": 6,
        "UnableToAcceptSerialNumberEvents7": 7,
        "UnableToAcceptLabelEvents8": 8,
        "UnableToAcceptSIDEvents9": 9,
        "UnknownAggregationSID10": 10,
        "InsufficientPrivilegeToExecute11": 11
      },
      "properties": {
        "Undefined0": {
          "description": "Undefined value, should never be seen.",
          "type": "integer"
        },
        "NoError1": {
          "description": "There were no errors in processing the method.  ",
          "type": "integer"
        },
        "InvalidSerialNumberCollection2": {
          "description": "The Serial Number Collection ID does not match a Serial Number Collection managed by the server.",
          "type": "integer"
        },
        "InsufficientSerialNumbers3": {
          "description": "Fewer Serial Numbers are available from the pool, then are requested.",
          "type": "integer"
        },
        "InvalidSerialNumbersFormat4": {
          "description": "The serial number format is not known or defined in the server",
          "type": "integer"
        },
        "InvalidRequestToken5": {
          "description": "The Request Token has a value not understood by the server.",
          "type": "integer"
        },
        "InvalidSelectionCriteria6": {
          "description": "The Selection Criteria is not known or defined in the server.",
          "type": "integer"
        },
        "UnableToAcceptSerialNumberEvents7": {
          "description": "The server cannot accept Serial Number events.",
          "type": "integer"
        },
        "UnableToAcceptLabelEvents8": {
          "description": "The server cannot accept Label events.",
          "type": "integer"
        },
        "UnableToAcceptSIDEvents9": {
          "description": "The server cannot accept SID events.",
          "type": "integer"
        },
        "UnknownAggregationSID10": {
          "description": "The SID of the aggregation for packing or unpacking is unknown.",
          "type": "integer"
        },
        "InsufficientPrivilegeToExecute11": {
          "description": " The server has determined that the client does not have sufficient privilege for the method to execute.",
          "type": "integer"
        }
      }
    },
    "OPENSCSSerialNumberStateEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.OPENSCS-SER.OPENSCSSerialNumberStateEnum",
      "const": {
        "Unassigned0": 0,
        "Unallocated1": 1,
        "Allocated2": 2,
        "SNInvalid3": 3,
        "Encoded4": 4,
        "LabelSampled5": 5,
        "LabelScrapped6": 6,
        "Commissioned7": 7,
        "Sampled8": 8,
        "Inactive9": 9,
        "Destroyed10": 10,
        "Released11": 11
      },
      "properties": {
        "Unassigned0": {
          "description": "The Serial Number has not been assigned to production or a packaging run.",
          "type": "integer"
        },
        "Unallocated1": {
          "description": "As Serial Number has been assigned to production or a packaging run, but it has not yet been allocated for use a specific production run of a product or aggregation.",
          "type": "integer"
        },
        "Allocated2": {
          "description": "The Serial Number has been assigned to a specific product or aggregation production run. ",
          "type": "integer"
        },
        "SNInvalid3": {
          "description": "The Serial Number is no longer viable, and the related serial number is no longer defined. ",
          "type": "integer"
        },
        "Encoded4": {
          "description": "The Serial Number has been written to a barcode or RFID tag, but not yet commissioned.",
          "type": "integer"
        },
        "LabelSampled5": {
          "description": "The printed label has been retained and is not associated with a physical product or aggregation.",
          "type": "integer"
        },
        "LabelScrapped6": {
          "description": "A label was encoded with a Serial Number, but was made unusable before being applied to a product or aggregation.",
          "type": "integer"
        },
        "Commissioned7": {
          "description": "The Serial Number has been associated with a physical product or aggregation, but has not yet left the responsibility of production",
          "type": "integer"
        },
        "Sampled8": {
          "description": "The product or aggregation is to be used as a sample for testing or other use, not to be made active.",
          "type": "integer"
        },
        "Inactive9": {
          "description": "The product or aggregation is no longer active, but may not have been destroyed.",
          "type": "integer"
        },
        "Destroyed10": {
          "description": "The product or aggregation was has been fully rendered non-usable.",
          "type": "integer"
        },
        "Released11": {
          "description": "The Serial Number has been associated with a physical product or aggregation, and has left the responsibility of production.",
          "type": "integer"
        }
      }
    }
