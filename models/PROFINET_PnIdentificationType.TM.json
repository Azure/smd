    },
    "SoftwareRevision": {
      "dov:namespace": "http://opcfoundation.org/UA/PROFINET/",
      "type": "string",
      "readOnly": true
    },
    "TagFunction": {
      "dov:namespace": "http://opcfoundation.org/UA/PROFINET/",
      "type": "string",
