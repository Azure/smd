{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/#OpcUaCore_SerializationEntityType",
  "title": "OpcUaCore_SerializationEntityType",
  "dov:typeRef": "org.opcfoundation.UA.SerializationEntityType",
  "dov:isComposite": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/#OpcUaCore_BaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/actions/ConfigureSerialization",
    "/properties/ConsiderSubElementSerializationProperties",
    "/properties/CustomMetaDataProperties",
    "/properties/CustomMetaDataRef",
    "/properties/ExcludeReferenceTypes",
    "/properties/IncludeDictionaryReference",
    "/properties/IncludeReferenceTypes",
    "/properties/IncludeSourceTimestamp",
    "/properties/IncludeStatus",
    "/properties/SerializationDepth"
  ],
  "actions": {
