{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.DI.InstallationStateMachineType",
  "title": "DI_InstallationStateMachineType",
  "dov:typeRef": "org.opcfoundation.UA.DI.InstallationStateMachineType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.FiniteStateMachineType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "Idle",
      "href": "urn:org.opcfoundation.UA.InitialStateType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "Installing",
      "href": "urn:org.opcfoundation.UA.StateType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "Error",
      "href": "urn:org.opcfoundation.UA.StateType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "IdleToInstalling",
      "href": "urn:org.opcfoundation.UA.TransitionType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "InstallingToIdle",
      "href": "urn:org.opcfoundation.UA.TransitionType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "InstallingToError",
      "href": "urn:org.opcfoundation.UA.TransitionType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "ErrorToIdle",
      "href": "urn:org.opcfoundation.UA.TransitionType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/actions/InstallFiles",
    "/actions/InstallSoftwarePackage",
    "/actions/Uninstall",
    "/properties/InstallationDelay",
    "/properties/PercentComplete",
    "/events/InstallationDelay",
    "/events/PercentComplete"
  ],
  "actions": {
    "InstallFiles": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.DI.InputArguments",
        "required": [
          "NodeIds"
        ],
        "properties": {
          "NodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "InstallSoftwarePackage": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.DI.InputArguments",
        "required": [
          "ManufacturerUri",
          "SoftwareRevision",
          "PatchIdentifiers",
          "Hash"
        ],
        "properties": {
          "ManufacturerUri": {
            "type": "string"
          },
          "SoftwareRevision": {
            "type": "string"
          },
          "PatchIdentifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Hash": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      }
    },
    "Resume": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/"
    },
    "Uninstall": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/"
    }
  },
  "properties": {
    "InstallationDelay": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": true
    },
    "PercentComplete": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "readOnly": true
    }
  },
  "events": {
    "InstallationDelay": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "data": {
        "type": "string",
        "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
      }
    },
    "PercentComplete": {
      "dov:namespace": "http://opcfoundation.org/UA/DI/",
      "data": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}