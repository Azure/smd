  "schemaDefinitions": {
    "FilterClassEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.CAS.FilterClassEnum",
      "const": {
        "S0": 0,
        "S1": 1,
        "S2": 2,
        "S3": 3,
        "S4": 4,
        "S5": 5,
        "S6": 6,
        "S7": 7,
        "S8": 8,
        "S9": 9,
        "X": 10
      },
      "description": "possible filter classes according to ISO 8573-1",
      "properties": {
        "S0": {
          "description": "As specified by the equipment user or supplier and more stringent than class 1.",
          "type": "integer"
        },
        "S1": {
          "description": "Particles: By Particle Size: 0.1 µm < d ≤ 0.5 µm: ≤ 20,000; 0.5 µ m< d ≤ 1.0 µm: ≤ 400; 1.0 µm < d ≤ 5.0 µm: ≤ 10; Water: Vapor Pressure Dewpoint: ≤ -70 °C, ≤ -94 °F; Oil: Liquid, Aerosol, & Vapor: ≤ 0.01 mg/m3;",
          "type": "integer"
        },
        "S2": {
          "description": "Particles: By Particle Size: 0.1 µm < d ≤ 0.5 µm: ≤ 400,000; 0.5 µ m< d ≤ 1.0 µm: ≤ 6,000; 1.0 µm < d ≤ 5.0 µm: ≤ 100; Water: Vapor Pressure Dewpoint: ≤ -40 °C, ≤ -40 °F; Oil: Liquid, Aerosol, & Vapor: ≤ 0.1 mg/m3;",
          "type": "integer"
        },
        "S3": {
          "description": "Particles: By Particle Size: 0.5 µ m< d ≤ 1.0 µm: ≤ 90,000; 1.0 µm < d ≤ 5.0 µm: ≤ 1,000; Water: Vapor Pressure Dewpoint: ≤ -20 °C, ≤ -4 °F; Oil: Liquid, Aerosol, & Vapor: ≤ 1 mg/m3;",
          "type": "integer"
        },
        "S4": {
          "description": "Particles: By Particle Size: 1.0 µm < d ≤ 5.0 µm: ≤ 10,000; Water: Vapor Pressure Dewpoint: ≤ +3 °C, ≤ +37 °F; Oil: Liquid, Aerosol, & Vapor: ≤ 5 mg/m3;",
          "type": "integer"
        },
        "S5": {
          "description": "Particles: By Particle Size: 1.0 µm < d ≤ 5.0 µm: ≤ 100,000; Water: Vapor Pressure Dewpoint: ≤ +7 °C, ≤ +45 °F;",
          "type": "integer"
        },
        "S6": {
          "description": "Particles: By Mass: 0 – ≤ 5 mg/m3; Water: Vapor Pressure Dewpoint: ≤ +10 °C, ≤ +50 °F;",
          "type": "integer"
        },
        "S7": {
          "description": "Particles: By Mass: 5 – ≤ 10 mg/m3; Water: Liquid: ≤ 0.5 g/m3;",
          "type": "integer"
        },
        "S8": {
          "description": "Water: Liquid: ≤ 5 g/m3;",
          "type": "integer"
        },
        "S9": {
          "description": "Water: Liquid: ≤ 10 g/m3;",
          "type": "integer"
        },
        "X": {
          "description": "Particles: By Mass: > 10 mg/m3; Water: Liquid: > 10 g/m3; Oil: Liquid, Aerosol, & Vapor: > 5 mg/m3;",
          "type": "integer"
        }
      }
    },
    "FilterTypeEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.CAS.FilterTypeEnum",
      "const": {
        "Other": 0,
        "ActivatedCarbonFilter": 1,
        "AdsorptionFilter": 2,
        "CoalescingFilter": 3,
        "ParticulateFilter": 4,
        "FabricFilter": 5,
        "SterileFilter": 6
      },
      "description": "possible filter types",
      "properties": {
        "Other": {
          "description": "Not specified in this enumeration",
          "type": "integer"
        },
        "ActivatedCarbonFilter": {
          "description": "Activated carbon filter",
          "type": "integer"
        },
        "AdsorptionFilter": {
          "description": "Adsorption filter",
          "type": "integer"
        },
        "CoalescingFilter": {
          "description": "Coalescing filter",
          "type": "integer"
        },
        "ParticulateFilter": {
          "description": "Particulate filter",
          "type": "integer"
        },
        "FabricFilter": {
          "description": "Fabric filter",
          "type": "integer"
        },
        "SterileFilter": {
          "description": "Sterile filter",
          "type": "integer"
        }
      }
    }
  },
