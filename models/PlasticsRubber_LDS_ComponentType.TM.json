      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": true
    },
    "ResidualAmount": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/LDS/",
      "description": "Residual amount of the material",
      "type": "number",
      "minimum": -1.80e+308,
      "maximum": 1.80e+308,
      "readOnly": true
    },
    "SetFollowerPlatePressure": {
