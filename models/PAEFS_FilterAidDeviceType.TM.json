      "type": "boolean",
      "readOnly": true
    },
    "ContainerOpen": {
      "dov:namespace": "http://opcfoundation.org/UA/PAEFS/",
      "description": "Indicates that the filter aid reservoir is not closed.",
      "type": "boolean",
      "readOnly": true
    },
    "DosingRequested": {
      "dov:namespace": "http://opcfoundation.org/UA/PAEFS/",
      "description": "Indicates that the filter system requests dosing.",
      "type": "boolean",
      "readOnly": true
    },
    "FilterAidDeviceStatus": {
      "dov:namespace": "http://opcfoundation.org/UA/PAEFS/",
      "title": "FilterAidDeviceStatusEnum",
