    "ProductionOrderHeader": {
      "dov:namespace": "http://opcfoundation.org/UA/TMC/v2/",
      "title": "ProductionOrderHeaderType",
      "description": "The ProductionOrderHeaderType structure contains the header information for a production  order.",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.TMC.v2.ProductionOrderHeaderType",
      "required": [
        "Number",
        "ProducedMaterial",
        "TargetQuantity",
        "ContinueAtJobEnd",
        "TargetStartTime",
        "TargetEndTime",
        "DataSetID",
        "DataSetDescription",
        "MaterialListID",
        "MaterialListDescription"
      ],
      "properties": {
        "Number": {
          "description": "The production order number.",
          "type": "string"
        },
        "ProducedMaterial": {
          "title": "MaterialDefinitionType",
          "description": "The MaterialDefinitionType structure contains the definition of a material. It is harmonised with  ISA 95 Material Definition.",
          "type": "object",
          "dov:typeRef": "org.opcfoundation.UA.TMC.v2.MaterialDefinitionType",
          "required": [
            "ID",
            "MES_ID",
            "Description",
            "BaseUnitOfMeasure",
            "BatchManaged"
          ],
          "properties": {
            "ID": {
              "description": "Unique identifier for the material definition.",
              "type": "string"
            },
            "MES_ID": {
              "description": "Unique identifier for the material definition in an external system, e.g.  MES.",
              "type": "string"
            },
            "Description": {
              "description": "Description of the material definition.",
              "type": "string"
            },
            "BaseUnitOfMeasure": {
              "title": "EUInformation",
              "description": "The base unit of measure for the material definition.",
              "type": "object",
              "dov:typeRef": "org.opcfoundation.UA.EUInformation",
              "required": [
                "NamespaceUri",
                "UnitId",
                "DisplayName",
                "Description"
              ],
              "properties": {
                "NamespaceUri": {
                  "type": "string"
                },
                "UnitId": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "DisplayName": {
                  "type": "string"
                },
                "Description": {
                  "type": "string"
                }
              }
            },
            "BatchManaged": {
              "description": "If BatchManaged is True, the material lots of this material definition  require a unique identification, often called BatchID. The material lots are  also called batches in some contexts.",
              "type": "boolean"
            },
            "GroupID": {
              "description": "The material group the material definition belongs to.",
              "type": "string"
            },
            "ParentGroupID": {
              "description": "The parent group of the material group the material definition belongs to.",
              "type": "string"
            },
            "ShelfLife": {
              "description": "The number of days of usable life for the material definition. The usable  life is counted from the production date.",
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "Properties": {
              "description": "An array containing additional properties that can be additionally  required for the material definition.",
              "type": "array",
              "items": {
                "title": "DataDescriptionType",
                "description": "The DataDescriptionType structure contains a metadata, i.e. a description.",
                "type": "object",
                "dov:typeRef": "org.opcfoundation.UA.TMC.v2.DataDescriptionType",
                "required": [
                  "ID",
                  "MES_ID",
                  "Description"
                ],
                "properties": {
                  "ID": {
                    "description": "Unique identifier for the metadata description.",
                    "type": "string"
                  },
                  "MES_ID": {
                    "description": "Unique identifier for the metadata description in an external system,  e.g. MES.",
                    "type": "string"
                  },
                  "Description": {
                    "description": "The metadata description.",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "TargetQuantity": {
          "description": "The quantity of ProducedMaterial that is requested by the production  order.",
          "type": "number",
          "minimum": -1.80e+308,
          "maximum": 1.80e+308
        },
        "ContinueAtJobEnd": {
          "description": "When ContinueAtJobEnd is True, then the operator may continue  production (overproduction) after fulfilling the required  TargetQuantity.",
          "type": "boolean"
        },
        "TargetStartTime": {
          "description": "The planned start date and time.",
          "type": "string",
          "format": "time"
        },
        "TargetEndTime": {
          "description": "The planned end date and time.",
          "type": "string",
          "format": "time"
        },
        "DataSetID": {
          "description": "The identifier of the dataset to be used for the production order,  when the dataset is late-bound. The DatasetID will be NULL when the  dataset is not late-bound.",
          "type": "string"
        },
        "DataSetDescription": {
          "description": "The description of the dataset.",
          "type": "string"
        },
        "MaterialListID": {
          "description": "The identifier of the material list to be used for the production order,  when the material list is late-bound. The DatasetID will be NULL when  the dataset is not late-bound.",
          "type": "string"
        },
        "MaterialListDescription": {
          "description": "The description of the material list.",
          "type": "string"
        }
      },
      "readOnly": true
    },
