                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                },
                "Value": {
                  "description": "Stand-in for an unspecified data type.",
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.OutputArguments",
        "required": [
          "VerificationResult",
          "VerificationVariablesErrors"
        ],
        "properties": {
          "VerificationResult": {
            "title": "FunctionalEntityVerificationResultEnum",
