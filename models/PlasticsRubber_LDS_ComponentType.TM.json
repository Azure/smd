  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.PlasticsRubber.LDS.ComponentType",
  "title": "PlasticsRubber_LDS_ComponentType",
  "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.LDS.ComponentType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.BaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "ComponentStatusEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.LDS.ComponentStatusEnumeration",
      "const": {
        "GOOD": 0,
        "WARNING": 1,
        "WARNING_PRESSURE_TOO_HIGH": 2,
        "WARNING_PRESSURE_TOO_LOW": 3,
        "ADVANCE_WARNING_DRUM_CHANGE": 4,
        "ERROR_DRUM_EMPTY": 5,
        "ERROR": 6
      },
      "description": "Actual status of the component provides a minimal error handling for devices without event support.",
      "properties": {
        "GOOD": {
          "description": "Component has no error or warning.",
          "type": "integer"
        },
        "WARNING": {
          "description": "The component has an undefined warning, but no need to stop the production.",
          "type": "integer"
        },
        "WARNING_PRESSURE_TOO_HIGH": {
          "description": "Pressure is too high. No need to stop the process but influence to the part quality.",
          "type": "integer"
        },
        "WARNING_PRESSURE_TOO_LOW": {
          "description": "Pressure is too low. No need to stop the process but influence to the part quality.",
          "type": "integer"
        },
        "ADVANCE_WARNING_DRUM_CHANGE": {
          "description": "Warning, barrel change is imminent. No need to stop the process.",
          "type": "integer"
        },
        "ERROR_DRUM_EMPTY": {
          "description": "Drum of the component is empty. Production needs to be stopped.",
          "type": "integer"
        },
        "ERROR": {
          "description": "The component has an error and process needs to be stopped.",
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
    "/actions/SetSetValueDensity",
    "/properties/ActualFollowerPlatePressure",
