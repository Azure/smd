    "/events/ResidualAmount",
    "/events/SetFollowerPlatePressure",
    "/events/SetValueDensity"
  ],
  "actions": {
    "SetSetValueDensity": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/LDS/",
      "description": "This optional method is used to modify SetValueDensity if allowed by the device.",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.LDS.InputArguments",
        "required": [
