  "id": "http://opcfoundation.org/UA/CAS/#CAS_AirnetOperationalType",
  "title": "CAS_AirnetOperationalType",
  "dov:typeRef": "org.opcfoundation.UA.CAS.AirnetOperationalType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/CAS/#CAS_OperationalType",
      "type": "application/tm+json"
