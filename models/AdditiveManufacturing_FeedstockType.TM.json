  "schemaDefinitions": {
    "FeedstockFunction": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.AdditiveManufacturing.FeedstockFunction",
      "const": {
        "Undefined": 0,
        "Main": 1,
        "Ancillary": 2,
        "Consumable": 3
      },
      "description": "This enumeration indicates the function of a specific feedstock.",
      "properties": {
        "Undefined": {
          "description": "The function of the feedstock is unknown.",
          "type": "integer"
        },
        "Main": {
          "description": "The feedstock is used for production and is part of the finished part.",
          "type": "integer"
        },
        "Ancillary": {
          "description": "The feedstock is used for production but removed before the part is finished.",
          "type": "integer"
        },
        "Consumable": {
          "description": "The feedstock is consumed during the production e.g., process gas.",
          "type": "integer"
        }
      }
    },
    "AnalogUnitType": {
      "dov:typeRef": "org.opcfoundation.UA.AnalogUnitType",
      "type": "number"
    }
  },
