  ],
  "actions": {
    "SendCyclicJobList": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Sends a list of jobs for cyclic processes available on the client to the server",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "JobList"
        ],
        "properties": {
          "JobList": {
            "type": "array",
            "items": {
              "title": "CyclicJobListElementType",
              "description": "Description of a job in a cyclic job list",
              "type": "object",
              "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.CyclicJobListElementType",
              "required": [
                "JobName",
                "JobDescription",
                "JobClassification",
                "CustomerName",
                "ProductionDatasetName",
                "ProductionDatasetDescription",
                "Material",
                "ProductName",
                "ProductDescription",
                "JobPriority",
                "PlannedStart",
                "PlannedProductionTime",
                "LatestEnd",
                "NominalParts",
                "NominalBoxParts",
                "ExpectedCycleTime",
                "MouldId",
                "NumCavities"
              ],
              "properties": {
                "JobName": {
                  "description": "Name of the job",
                  "type": "string"
                },
                "JobDescription": {
                  "description": "Description of the job",
                  "type": "string"
                },
                "JobClassification": {
                  "description": "Classification of the job",
                  "type": "string"
                },
                "CustomerName": {
                  "description": "Name of the cumstomer for that the job is produced",
                  "type": "string"
                },
                "ProductionDatasetName": {
                  "description": "Name of the production dataset which is needed for the job",
                  "type": "string"
                },
                "ProductionDatasetDescription": {
                  "description": "Additional description of the production dataset which is needed for the job",
                  "type": "string"
                },
                "Material": {
                  "description": "Array of material names used for the job",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ProductName": {
                  "description": "Array of product names produced by the job",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ProductDescription": {
                  "description": "Array of descriptions of the products produced by the job",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "JobPriority": {
                  "description": "Priority of the job",
                  "type": "string"
                },
                "PlannedStart": {
                  "description": "Planned start of the job",
                  "type": "string",
                  "format": "date-time"
                },
                "PlannedProductionTime": {
                  "description": "Planned production time",
                  "type": "string",
                  "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
                },
                "LatestEnd": {
                  "description": "Latest end of the job",
                  "type": "string",
                  "format": "date-time"
                },
                "NominalParts": {
                  "description": "Total number (sum of all cavities) of parts that shall be produced by the job",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "NominalBoxParts": {
                  "description": "Number of parts that shall be put into one box",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "ExpectedCycleTime": {
                  "description": "Calculated cycle time for the job",
                  "type": "string",
                  "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
                },
                "MouldId": {
                  "description": "Id of the mould used for the job",
                  "type": "string"
                },
                "NumCavities": {
                  "description": "Number of cavities in the mould used for production",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          }
        }
      }
    },
    "SendJobList": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Sends a list of jobs available on the client to the server",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "JobList"
        ],
        "properties": {
          "JobList": {
            "type": "array",
            "items": {
              "title": "JobListElementType",
              "description": "Description of a job in a job list",
              "type": "object",
              "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.JobListElementType",
              "required": [
                "JobName",
                "JobDescription",
                "JobClassification",
                "CustomerName",
                "ProductionDatasetName",
                "ProductionDatasetDescription",
                "Material",
                "ProductName",
                "ProductDescription",
                "JobPriority",
                "PlannedStart",
                "PlannedProductionTime",
                "LatestEnd"
              ],
              "properties": {
                "JobName": {
                  "description": "Name of the job",
                  "type": "string"
                },
                "JobDescription": {
                  "description": "Description of the job",
                  "type": "string"
                },
                "JobClassification": {
                  "description": "Classification of the job",
                  "type": "string"
                },
                "CustomerName": {
                  "description": "Name of the cumstomer for that the job is produced",
                  "type": "string"
                },
                "ProductionDatasetName": {
                  "description": "Name of the production dataset which is needed for the job",
                  "type": "string"
                },
                "ProductionDatasetDescription": {
                  "description": "Additional description of the production dataset which is needed for the job",
                  "type": "string"
                },
                "Material": {
                  "description": "Array of material names used for the job",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ProductName": {
                  "description": "Array of product names produced by the job",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ProductDescription": {
                  "description": "Array of descriptions of the products produced by the job",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "JobPriority": {
                  "description": "Priority of the job",
                  "type": "string"
                },
                "PlannedStart": {
                  "description": "Planned start of the job",
                  "type": "string",
                  "format": "date-time"
                },
                "PlannedProductionTime": {
                  "description": "Planned production time",
                  "type": "string",
                  "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$"
                },
                "LatestEnd": {
                  "description": "Latest end of the job",
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}