          "CredentialId",
          "RequestedSecurityPolicyUri"
        ],
        "properties": {
          "CredentialId": {
            "type": "string"
          },
          "RequestedSecurityPolicyUri": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.OutputArguments",
        "required": [
          "PublicKey",
          "RevisedSecurityPolicyUri"
        ],
        "properties": {
          "PublicKey": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "RevisedSecurityPolicyUri": {
            "type": "string"
          }
        }
      }
    },
    "UpdateCredential": {
