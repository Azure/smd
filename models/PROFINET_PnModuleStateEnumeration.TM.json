  "links": [],
  "schemaDefinitions": {
    "PnModuleStateEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PROFINET.PnModuleStateEnumeration",
      "const": {
        "NO_MODULE": 0,
        "WRONG_MODULE": 1,
        "PROPER_MODULE": 2,
        "SUBSTITUTE": 3,
        "OK": 4
      },
      "properties": {
        "NO_MODULE": {
          "description": "For example module not plugged",
          "type": "integer"
        },
        "WRONG_MODULE": {
          "description": "For example ModuleIdentNumber wrong",
          "type": "integer"
        },
        "PROPER_MODULE": {
          "description": "Module is okay but at least one submodule is locked, wrong or missing",
          "type": "integer"
        },
        "SUBSTITUTE": {
          "description": "Module is not the same as requested – but the IO device was able to adapt by its own knowledge",
          "type": "integer"
        },
        "OK": {
          "description": "Default state",
          "type": "integer"
        }
      }
    }
  }
