  ],
  "properties": {
    "ActiveSetValue": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/HotRunner/",
      "description": "Current active set temperature for the temperature zone ",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "readOnly": true
    },
    "BoostSetValue": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/HotRunner/",
      "description": "Set value for boost mode",
      "type": "number",
      "minimum": -1.80e+308,
      "maximum": 1.80e+308,
      "readOnly": false
    },
    "BoostTime": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/HotRunner/",
      "description": "Duration of the boost mode after which the set value which was active before boost is becoming active again",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": false
    },
    "SecondSetValue": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/HotRunner/",
      "description": "Second set value for fast switch-over",
      "type": "number",
      "minimum": -1.80e+308,
      "maximum": 1.80e+308,
      "readOnly": false
    },
    "StandbySetValue": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/HotRunner/",
      "description": "Set value for standby mode",
      "type": "number",
      "minimum": -1.80e+308,
      "maximum": 1.80e+308,
      "readOnly": false
    },
    "TimeMethodPIDParameters": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/HotRunner/",
      "description": "Setting of PID parameters with time method",
      "type": "array",
      "items": {
        "title": "TimeMethodPIDParametersDataType",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.HotRunner.TimeMethodPIDParametersDataType",
        "required": [
          "Xp",
          "Tn",
          "Tv",
          "Ts"
        ],
        "properties": {
          "Xp": {
            "description": "proportional band",
            "type": "number",
            "minimum": -1.80e+308,
            "maximum": 1.80e+308
          },
          "Tn": {
            "description": "reset time",
            "type": "number",
            "minimum": -1.80e+308,
            "maximum": 1.80e+308
          },
          "Tv": {
            "description": "derivative time",
            "type": "number",
            "minimum": -1.80e+308,
            "maximum": 1.80e+308
          },
          "Ts": {
            "description": "sample time",
            "type": "number",
            "minimum": -1.80e+308,
            "maximum": 1.80e+308
          }
        }
      },
      "readOnly": false
    }
  },
