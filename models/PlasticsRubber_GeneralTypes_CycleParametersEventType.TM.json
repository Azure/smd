      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "readOnly": true
    },
    "BoxTestSamplesCounter": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Number of test sample parts produced in the current box",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "readOnly": true
    },
    "CavityCycleQuality": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Quality of the cycle for each cavity ",
      "type": "array",
      "items": {
        "title": "CavityCycleQualityEnumeration",
        "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.CavityCycleQualityEnumeration",
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "readOnly": true
    },
    "CurrentLotName": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Name of the current production lot",
      "type": "string",
      "readOnly": true
    },
    "CycleQuality": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "title": "CycleQualityEnumeration",
      "description": "Quality of the whole cycle",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GeneralTypes.CycleQualityEnumeration",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "readOnly": true
    },
    "CycleTime": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Cycle time",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": true
    },
    "JobBadPartsCounter": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Number of bad parts produced in the current job",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "readOnly": true
    },
    "JobCycleCounter": {
      "dov:namespace": "http://opcfoundation.org/UA/PlasticsRubber/GeneralTypes/",
      "description": "Number of the cycle in the job",
      "type": "integer",
