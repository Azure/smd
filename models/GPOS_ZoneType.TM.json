  "links": [
    {
      "rel": "tm:extends",
      "href": "urn:org.opcfoundation.UA.BaseObjectType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/properties/Building",
    "/properties/Floor",
    "/properties/GroundControlPoints",
    "/properties/IncompleteConfiguration",
    "/properties/Position",
    "/properties/Radius",
    "/properties/Site",
    "/events/GroundControlPoints",
    "/events/Position",
    "/events/Radius"
  ],
  "properties": {
    "Building": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "Name of the building",
      "type": "string",
      "readOnly": false
    },
    "Floor": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "Name of the floor",
      "type": "string",
      "readOnly": false
    },
    "GroundControlPoints": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "Points defining the extent of the zone",
      "type": "array",
      "items": {
        "title": "GroundControlPointDataType",
        "description": "Defines a pair of coordinates - local and global - to allow geo-references from local coordinate to a global coordinate system",
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.GPOS.GroundControlPointDataType",
        "required": [
          "GlobalPosition",
          "LocalPosition"
        ],
        "properties": {
          "GlobalPosition": {
            "title": "S3DGeographicCoordinateDataType",
            "description": "Represents a geographic coordinate",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.GPOS.S3DGeographicCoordinateDataType",
            "required": [
              "Longitude",
              "Latitude"
            ],
            "properties": {
              "Longitude": {
                "description": "MUST be interpreted according to the CoordinateReferenceSystem",
                "type": "number",
                "minimum": -1.80e+308,
                "maximum": 1.80e+308
              },
              "Latitude": {
                "description": "MUST be interpreted according to the CoordinateReferenceSystem",
                "type": "number",
                "minimum": -1.80e+308,
                "maximum": 1.80e+308
              },
              "Elevation": {
                "description": "MUST be interpreted according to the ElevationReference. If floor, the height relative to specific floor in meter",
                "type": "number",
                "minimum": -1.80e+308,
                "maximum": 1.80e+308
              }
            }
          },
          "LocalPosition": {
            "title": "ThreeDCartesianCoordinates",
            "description": "Local position in metric coordinates (in meter)",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.ThreeDCartesianCoordinates",
            "required": [
              "X",
              "Y",
              "Z"
            ],
            "properties": {
              "X": {
                "type": "number",
                "minimum": -1.80e+308,
                "maximum": 1.80e+308
              },
              "Y": {
                "type": "number",
                "minimum": -1.80e+308,
                "maximum": 1.80e+308
              },
              "Z": {
                "type": "number",
                "minimum": -1.80e+308,
                "maximum": 1.80e+308
              }
            }
          }
        }
      },
      "readOnly": false
    },
    "IncompleteConfiguration": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "Indicates if the configuration is complete. FALSE if configuration is complete.",
      "type": "boolean",
      "readOnly": false
    },
    "Position": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "title": "S3DGeographicCoordinateDataType",
      "description": "Represents a geographic coordinate",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.GPOS.S3DGeographicCoordinateDataType",
      "required": [
        "Longitude",
        "Latitude"
      ],
      "properties": {
        "Longitude": {
          "description": "MUST be interpreted according to the CoordinateReferenceSystem",
          "type": "number",
          "minimum": -1.80e+308,
          "maximum": 1.80e+308
        },
        "Latitude": {
          "description": "MUST be interpreted according to the CoordinateReferenceSystem",
          "type": "number",
          "minimum": -1.80e+308,
          "maximum": 1.80e+308
        },
        "Elevation": {
          "description": "MUST be interpreted according to the ElevationReference. If floor, the height relative to specific floor in meter",
          "type": "number",
          "minimum": -1.80e+308,
          "maximum": 1.80e+308
        }
      },
      "readOnly": false
    },
    "Radius": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "For proximity-based systems. Describes the zone as a circular region with a given radius in meters around the position.",
      "type": "number",
      "minimum": -1.80e+308,
      "maximum": 1.80e+308,
      "readOnly": false
    },
    "Site": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "Name of the site",
      "type": "string",
      "readOnly": false
    },
    "ZoneId": {
      "dov:namespace": "http://opcfoundation.org/UA/GPOS/",
      "description": "A unique identifier of the zone (e.g. a GUID).",
      "type": "string",
      "readOnly": false
    }
  },
