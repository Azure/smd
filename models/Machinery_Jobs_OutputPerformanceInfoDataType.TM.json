  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/Machinery/Jobs/#Machinery_Jobs_OutputPerformanceInfoDataType",
  "title": "Machinery_Jobs_OutputPerformanceInfoDataType",
  "dov:typeRef": "org.opcfoundation.UA.Machinery.Jobs.OutputPerformanceInfoDataType",
  "links": [],
  "schemaDefinitions": {
    "OutputPerformanceInfoDataType": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.Machinery.Jobs.OutputPerformanceInfoDataType",
      "required": [
        "Identification",
        "Parameters"
      ],
      "properties": {
        "Identification": {
          "title": "OutputInformationDataType",
          "description": "Identification of the output.",
          "type": "object",
          "dov:typeRef": "org.opcfoundation.UA.Machinery.Jobs.OutputInformationDataType",
          "required": [
            "ItemNumber",
            "OutputInfo"
          ],
          "properties": {
            "ItemNumber": {
              "description": "ItemNumber defines an Identifier to identify the Type of the item (Material Identifier).",
              "type": "string"
            },
            "OutputInfo": {
              "title": "OutputInfoType",
              "description": "Bitmask indicating which of the optional fields are used for identification. If none is selected, only ItemNumber is used. Each selected optional field shall provide a value.",
              "dov:typeRef": "org.opcfoundation.UA.Machinery.Jobs.OutputInfoType",
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "OrderNumber": {
              "description": "OrderNumber defines an Identifier to identify the order. Shall be provided if defined in OutputInfo.",
              "type": "string"
            },
            "LotNumber": {
              "description": "LotNumber defines an Identifier to identify the production-group of the item (Lot Identifier). Shall be provided if defined in OutputInfo.",
              "type": "string"
            },
            "SerialNumber": {
              "description": "SerialNumber defines an Identifier to identify the one entity of the item (Product Identifier). Shall be provided if defined in OutputInfo.",
              "type": "string"
            }
          }
        },
        "StartTime": {
          "description": "Output of first item from order.",
          "type": "string",
          "format": "date-time"
        },
        "EndTime": {
          "description": "Output of last item from order.",
          "type": "string",
          "format": "date-time"
        },
        "Parameters": {
          "description": "Parameters specific to the performance like pressure or temperature.",
          "type": "array",
          "items": {
            "title": "ISA95ParameterDataType",
            "description": "A subtype of OPC UA Structure that defines three linked data items: the ID, which is a unique identifier for a property, the value, which is the data that is identified, and an optional description of the parameter.",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.ISA95-JOBCONTROL_V2.ISA95ParameterDataType",
            "required": [
              "ID",
              "Value"
            ],
            "properties": {
              "ID": {
                "description": "A unique identifier for a parameter",
                "type": "string"
              },
              "Value": {
                "description": "Value of the parameter.",
                "type": "string"
              },
              "Description": {
                "description": "An optional description of the parameter. The array allows to provide descriptions in different languages when writing. When accessing, the server shall only provide one entry in the array.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "EngineeringUnits": {
                "title": "EUInformation",
                "description": "The Unit Of Measure of the value",
                "type": "object",
                "dov:typeRef": "org.opcfoundation.UA.EUInformation",
                "required": [
                  "NamespaceUri",
                  "UnitId",
                  "DisplayName",
                  "Description"
                ],
                "properties": {
                  "NamespaceUri": {
                    "type": "string"
                  },
                  "UnitId": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  "DisplayName": {
                    "type": "string"
                  },
                  "Description": {
                    "type": "string"
                  }
                }
              },
              "Subparameters": {
                "type": "array",
                "items": {
                  "title": "ISA95ParameterDataType",
                  "description": "A subtype of OPC UA Structure that defines three linked data items: the ID, which is a unique identifier for a property, the value, which is the data that is identified, and an optional description of the parameter.",
                  "type": "object",
                  "dov:typeRef": "org.opcfoundation.UA.ISA95-JOBCONTROL_V2.ISA95ParameterDataType",
                  "required": [
                    "ID",
                    "Value"
                  ],
                  "properties": {
                    "ID": {
                      "description": "A unique identifier for a parameter",
                      "type": "string"
                    },
                    "Value": {
                      "description": "Value of the parameter.",
                      "type": "string"
                    },
                    "Description": {
                      "description": "An optional description of the parameter. The array allows to provide descriptions in different languages when writing. When accessing, the server shall only provide one entry in the array.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "EngineeringUnits": {
                      "title": "EUInformation",
                      "description": "The Unit Of Measure of the value",
                      "type": "object",
                      "dov:typeRef": "org.opcfoundation.UA.EUInformation",
                      "required": [
                        "NamespaceUri",
                        "UnitId",
                        "DisplayName",
                        "Description"
                      ],
                      "properties": {
                        "NamespaceUri": {
                          "type": "string"
                        },
                        "UnitId": {
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        },
                        "DisplayName": {
                          "type": "string"
                        },
                        "Description": {
                          "type": "string"
                        }
                      }
                    },
                    "Subparameters": {
                      "type": "array",
                      "items": {
                        "description": "Stand-in for the infinite remainder of this data structure, which is recursively defined.",
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
