{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/Scales/V2/#Scales_V2_PieceCountingScaleType",
  "title": "Scales_V2_PieceCountingScaleType",
  "dov:typeRef": "org.opcfoundation.UA.Scales.V2.PieceCountingScaleType",
  "dov:isComposite": true,
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/Scales/V2/#Scales_V2_ScaleDeviceType",
      "type": "application/tm+json"
    },
    {
      "rel": "dov:reference",
      "dov:refName": "ProductionPreset",
      "href": "http://opcfoundation.org/UA/Scales/V2/#Scales_V2_ProductionPresetType",
      "type": "application/tm+json"
    }
  ],
  "schemaDefinitions": {
    "AnalogItemType": {
      "dov:typeRef": "org.opcfoundation.UA.AnalogItemType",
      "type": "number"
    }
  },
  "tm:optional": [
    "/actions/StartReference",
    "/properties/ReferenceOptimisationRange",
    "/events/ReferenceOptimisationRange"
  ],
  "actions": {
    "SetNumberOfReferencePieces": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "NumberOfReferencePieces"
        ],
        "properties": {
          "NumberOfReferencePieces": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "SetReferencePieceWeight": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "description": "Sets the value for the ReferencePieceWeight (product-specific data).",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "ReferencePieceWeight",
          "EngineeringUnits"
        ],
        "properties": {
          "ReferencePieceWeight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "EngineeringUnits": {
            "title": "EUInformation",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.EUInformation",
            "required": [
              "NamespaceUri",
              "UnitId",
              "DisplayName",
              "Description"
            ],
            "properties": {
              "NamespaceUri": {
                "type": "string"
              },
              "UnitId": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "DisplayName": {
                "type": "string"
              },
              "Description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "StartReference": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "description": "Triggers the reference weighing process.",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.InputArguments",
        "required": [
          "NumberOfReferencePieces"
        ],
        "properties": {
          "NumberOfReferencePieces": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    }
  },
  "properties": {
    "CurrentPieceCount": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "description": "Defines the number of pieces that are currently measured related to the ReferencePieceWeight.",
      "type": "number",
      "readOnly": false
    },
    "ReferenceOptimisationRange": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "tm:ref": "#/schemaDefinitions/AnalogItemType",
      "readOnly": false
    }
  },
  "events": {
    "CurrentPieceCount": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "data": {
        "description": "Defines the number of pieces that are currently measured related to the ReferencePieceWeight.",
        "type": "number"
      }
    },
    "ReferenceOptimisationRange": {
      "dov:namespace": "http://opcfoundation.org/UA/Scales/V2/",
      "data": {
        "tm:ref": "#/schemaDefinitions/AnalogItemType"
      }
    }
  }
}