  "schemaDefinitions": {
    "AssetVerificationModeEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.AssetVerificationModeEnum",
      "const": {
        "AssetCompatibility": 0,
        "AssetIdentity": 1,
        "AssetIdentityAndCompatibility": 2
      },
      "properties": {
        "AssetCompatibility": {
          "description": "Verify whether an Asset’s functionality matches or is compatible to the expectation of system engineering.",
          "type": "integer"
        },
        "AssetIdentity": {
          "description": "Verify whether an Asset’s identity meets the expectation of system engineering.",
          "type": "integer"
        },
        "AssetIdentityAndCompatibility": {
          "description": "Verify whether an Asset’s identity meets the expectation of system engineering and whether its functionality matches or is compatible to the expectation of system engineering.",
          "type": "integer"
        }
      }
    },
    "AssetVerificationResultEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.AssetVerificationResultEnum",
      "const": {
        "NotSet": 0,
        "Match": 1,
        "Compatible": 2,
        "Mismatch": 3
      },
      "properties": {
        "NotSet": {
          "description": "The verification result is not set.",
          "type": "integer"
        },
        "Match": {
          "description": "Asset matches expectation.",
          "type": "integer"
        },
        "Compatible": {
          "description": "Asset does not match expectation but is compatible.",
          "type": "integer"
        },
        "Mismatch": {
          "description": "Asset does not match expectation and is not compatible.",
          "type": "integer"
        }
      }
    },
    "DeviceHealthEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.DI.DeviceHealthEnumeration",
      "const": {
        "NORMAL": 0,
        "FAILURE": 1,
        "CHECK_FUNCTION": 2,
        "OFF_SPEC": 3,
        "MAINTENANCE_REQUIRED": 4
      },
      "properties": {
        "NORMAL": {
          "description": "This device functions normally.",
          "type": "integer"
        },
        "FAILURE": {
          "description": "Malfunction of the device or any of its peripherals.",
          "type": "integer"
        },
        "CHECK_FUNCTION": {
          "description": "Functional checks are currently performed.",
          "type": "integer"
        },
        "OFF_SPEC": {
          "description": "The device is currently working outside of its specified range or that internal diagnoses indicate deviations from measured or set values.",
          "type": "integer"
        },
        "MAINTENANCE_REQUIRED": {
          "description": "This element is working, but a maintenance operation is required.",
          "type": "integer"
        }
      }
    }
  },
