{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "http://opcfoundation.org/UA/GMS/#GMS_CalibrationPrognosisType",
  "title": "GMS_CalibrationPrognosisType",
  "dov:typeRef": "org.opcfoundation.UA.GMS.CalibrationPrognosisType",
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://opcfoundation.org/UA/MachineTool/#MachineTool_PrognosisType",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/properties/CalibrationCertificate",
    "/properties/CalibrationInterval",
    "/properties/CalibrationPreptime"
  ],
  "properties": {
    "Calibrated": {
      "dov:namespace": "http://opcfoundation.org/UA/GMS/",
      "type": "boolean",
      "readOnly": false
    },
    "CalibrationCertificate": {
      "dov:namespace": "http://opcfoundation.org/UA/GMS/",
      "type": "array",
      "items": {
        "type": "string"
      },
      "readOnly": false
    },
    "CalibrationInterval": {
      "dov:namespace": "http://opcfoundation.org/UA/GMS/",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": false
    },
    "CalibrationPreptime": {
      "dov:namespace": "http://opcfoundation.org/UA/GMS/",
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": false
    },
    "DateOfCalibration": {
      "dov:namespace": "http://opcfoundation.org/UA/GMS/",
      "type": "string",
      "format": "time",
      "readOnly": false
    }
  }
}