  "schemaDefinitions": {
    "FunctionalEntityVerificationResultEnum": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.FX.Data.FunctionalEntityVerificationResultEnum",
      "const": {
        "NotSet": 0,
        "Match": 1,
        "Mismatch": 2
      },
      "properties": {
        "NotSet": {
          "description": "The verification result is not set.",
          "type": "integer"
        },
        "Match": {
          "description": "FunctionalEntity matches expectation.",
          "type": "integer"
        },
        "Mismatch": {
          "description": "FunctionalEntity does not match expectation.",
          "type": "integer"
        }
      }
    },
    "OperationalHealthOptionSet": {
      "type": "object",
