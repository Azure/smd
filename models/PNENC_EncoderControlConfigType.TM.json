  "schemaDefinitions": {
    "EncoderAlarmChannelControlEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNENC.EncoderAlarmChannelControlEnumeration",
      "const": {
        "ALARM_CHANNEL_DISABLED": 0,
        "ALARM_CHANNEL_ENABLED": 1
      },
      "properties": {
        "ALARM_CHANNEL_DISABLED": {
          "description": "No Profile specific diagnosis (default)",
          "type": "integer"
        },
        "ALARM_CHANNEL_ENABLED": {
          "description": "Profile specific diagnosis is switched-on",
          "type": "integer"
        }
      }
    },
    "EncoderPresetControlEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNENC.EncoderPresetControlEnumeration",
      "const": {
        "ENABLE_PRESET_CONTROL": 0,
        "DISABLE_PRESET_CONTROL": 1
      },
      "properties": {
        "ENABLE_PRESET_CONTROL": {
          "description": "G1_XIST1 is affected by a Set-/Shift home position function command",
          "type": "integer"
        },
        "DISABLE_PRESET_CONTROL": {
          "description": "Set-/Shift home position function does not affect G1_XIST1",
          "type": "integer"
        }
      }
    }
  },
