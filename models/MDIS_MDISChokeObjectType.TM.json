        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.InputArguments",
        "required": [
          "Position"
        ],
        "properties": {
          "Position": {
            "description": "A number (in percent) indicating the percent open",
            "type": "number",
            "minimum": -3.40e+38,
            "maximum": 3.40e+38
          }
        }
      }
    },
    "Step": {
      "dov:namespace": "http://opcfoundation.org/UA/MDIS",
      "input": {
        "type": "object",
        "dov:typeRef": "org.opcfoundation.UA.MDIS.InputArguments",
        "required": [
          "Direction",
          "Steps",
          "OverrideInterlocks",
          "SEM"
        ],
        "properties": {
          "Direction": {
            "title": "ChokeCommandEnum",
            "description": "The direction for the valve, true is opening a valve, false if closing the valve",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.ChokeCommandEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "Steps": {
            "description": "The number of steps to open/close the valve",
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "OverrideInterlocks": {
            "description": "Boolean indicating if the open or close command should override any defeat able interlocks",
            "type": "boolean"
          },
          "SEM": {
            "title": "SEMEnum",
            "description": "The selection of which SEM to send the command to",
            "dov:typeRef": "org.opcfoundation.UA.MDIS.SEMEnum",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      }
    }
  },
