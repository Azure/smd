                        "DisplayName",
                        "Description"
                      ],
                      "properties": {
                        "NamespaceUri": {
                          "type": "string"
                        },
                        "UnitId": {
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        },
                        "DisplayName": {
                          "type": "string"
                        },
                        "Description": {
                          "type": "string"
                        }
                      }
                    },
                    "ValueComponent": {
                      "description": "<p>Specifies the value of the numerical value.</p>",
                      "type": "number",
                      "minimum": -1.80e+308,
                      "maximum": 1.80e+308
                    },
                    "Tolerance": {
                      "description": "<p>Specifies the tolerance for the dimension.</p>",
                      "type": "array",
                      "items": {
                        "title": "Tolerance",
                        "type": "object",
