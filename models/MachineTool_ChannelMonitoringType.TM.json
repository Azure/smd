  "schemaDefinitions": {
    "ChannelMode": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MachineTool.ChannelMode",
      "const": {
        "Automatic": 0,
        "MdaMdi": 1,
        "JogManual": 2,
        "JogIncrement": 3,
        "TeachingHandle": 4,
        "Remote": 5,
        "Reference": 6,
        "Other": 7
      },
      "properties": {
        "Automatic": {
          "description": "NC channel mode Automatic – execute CNC part programs.",
          "type": "integer"
        },
        "MdaMdi": {
          "description": "NC channel mode Mda/Mdi – manual data input and execution.",
          "type": "integer"
        },
        "JogManual": {
          "description": "NC channel mode Jog Manual – axis movement triggered by user.",
          "type": "integer"
        },
        "JogIncrement": {
          "description": "NC channel mode Jog Increment – incremental axis movement triggered by user.",
          "type": "integer"
        },
        "TeachingHandle": {
          "description": "NC channel mode Teaching Handle – teaching a machine tool by moving axes of the machine tool by hand.",
          "type": "integer"
        },
        "Remote": {
          "description": "NC channel mode Remote – the machine tool can receive CNC files via a remote access mechanism.",
          "type": "integer"
        },
        "Reference": {
          "description": "NC channel mode Reference – The machine tool returns to its reference point/ zero position.",
          "type": "integer"
        },
        "Other": {
          "description": "NC channel mode is different from the values defined in this enumeration.",
          "type": "integer"
        }
      }
    },
    "ChannelState": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.MachineTool.ChannelState",
      "const": {
        "Active": 0,
        "Interrupted": 1,
        "Reset": 2
      },
      "properties": {
        "Active": {
          "description": "There is an active command being executed by the NC channel.",
          "type": "integer"
        },
        "Interrupted": {
          "description": "The NC execution is interrupted. Execution of a program in the channel can be restarted.",
          "type": "integer"
        },
        "Reset": {
          "description": "No NC command is active in the NC channel. E.g. channel is idle.",
          "type": "integer"
        }
      }
    }
  },
