{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "dov": "http://azure.com/DigitalOperations/vocab#"
    }
  ],
  "@type": "tm:ThingModel",
  "id": "urn:org.opcfoundation.UA.ISA95-JOBCONTROL_V2.ISA95PhysicalAssetDataType",
  "title": "ISA95_JOBCONTROL_V2_ISA95PhysicalAssetDataType",
  "dov:typeRef": "org.opcfoundation.UA.ISA95-JOBCONTROL_V2.ISA95PhysicalAssetDataType",
  "links": [],
  "schemaDefinitions": {
    "ISA95PhysicalAssetDataType": {
      "description": "Defines a physical asset, a quantity, an optional description, and an optional collection of properties.",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.ISA95-JOBCONTROL_V2.ISA95PhysicalAssetDataType",
      "required": [
        "ID"
      ],
      "properties": {
        "ID": {
          "description": "An identification of a Physical Asset Class or Physical Asset.",
          "type": "string"
        },
        "Description": {
          "description": "Additional information and description about the resource.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "PhysicalAssetUse": {
          "description": "Information about the expected use of the physical asset, see the ISA 95 Part 2 standard for defined values.",
          "type": "string"
        },
        "Quantity": {
          "description": "The quantity of the resource",
          "type": "string",
          "pattern": "^(?:\\+|-)?(?:[1-9][0-9]*|0)(?:\\.[0-9]*)?$"
        },
        "EngineeringUnits": {
          "title": "EUInformation",
          "description": "The Unit Of Measure of the quantity",
          "type": "object",
          "dov:typeRef": "org.opcfoundation.UA.EUInformation",
          "required": [
            "NamespaceUri",
            "UnitId",
            "DisplayName",
            "Description"
          ],
          "properties": {
            "NamespaceUri": {
              "type": "string"
            },
            "UnitId": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "DisplayName": {
              "type": "string"
            },
            "Description": {
              "type": "string"
            }
          }
        },
        "Properties": {
          "description": "Any associated properties, or empty if there are no properties defined.",
          "type": "array",
          "items": {
            "title": "ISA95PropertyDataType",
            "description": "A subtype of OPC UA Structure that defines two linked data items: an ID, which is a unique identifier for a property within the scope of the associated resource, and the value, which is the data for the property.",
            "type": "object",
            "dov:typeRef": "org.opcfoundation.UA.ISA95-JOBCONTROL_V2.ISA95PropertyDataType",
            "required": [
              "ID",
              "Value"
            ],
            "properties": {
              "ID": {
                "description": "Unique identifier for a property within the scope of the associated resource",
                "type": "string"
              },
              "Value": {
                "description": "Value for the property",
                "type": "string"
              },
              "Description": {
                "description": "An optional description of the parameter.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "EngineeringUnits": {
                "title": "EUInformation",
                "description": "The Unit Of Measure of the value",
                "type": "object",
                "dov:typeRef": "org.opcfoundation.UA.EUInformation",
                "required": [
                  "NamespaceUri",
                  "UnitId",
                  "DisplayName",
                  "Description"
                ],
                "properties": {
                  "NamespaceUri": {
                    "type": "string"
                  },
                  "UnitId": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  "DisplayName": {
                    "type": "string"
                  },
                  "Description": {
                    "type": "string"
                  }
                }
              },
              "Subproperties": {
                "type": "array",
                "items": {
                  "description": "Stand-in for the infinite remainder of this data structure, which is recursively defined.",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}