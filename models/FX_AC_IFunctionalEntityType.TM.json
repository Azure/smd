      "const": {
        "OperationalWarning": 16,
        "OperationalError": 17,
        "SubOperationalWarning": 18,
        "SubOperationalError": 19
      },
      "properties": {
        "OperationalWarning": {
          "description": "FunctionalEntity indicates a warning.",
          "type": "integer"
        },
        "OperationalError": {
          "description": "FunctionalEntity indicates an error.",
          "type": "integer"
        },
        "SubOperationalWarning": {
          "description": "One of the SubFunctionalEntities indicates a warning.",
          "type": "integer"
        },
        "SubOperationalError": {
          "description": "One of the SubFunctionalEntities indicates an error.",
          "type": "integer"
        }
      }
    }
