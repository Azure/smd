    }
  ],
  "schemaDefinitions": {
    "TsnStreamState": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.TsnStreamState",
      "const": {
        "Disabled": 0,
        "Configuring": 1,
        "Ready": 2,
        "Operational": 3,
        "Error": 4
      },
      "properties": {
        "Disabled": {
          "description": "The related TSN Stream is currently disabled.",
          "type": "integer"
        },
        "Configuring": {
          "description": "The related TSN Stream is in the process of receiving configuration parameters from the TSN Control Layer.",
          "type": "integer"
        },
        "Ready": {
          "description": "The related TSN Stream has successfully received and applied the configuration from the TSN Control Layer. The related TSN Stream is not fully operational as long as local preconditions (e.g. synchronization state) are not valid.",
          "type": "integer"
        },
        "Operational": {
          "description": "The related TSN Stream object is configured and all other required preconditions (e.g. synchronization state) for sending / receiving data are valid.",
          "type": "integer"
        },
        "Error": {
          "description": "The related TSN Stream object is in an error state.",
          "type": "integer"
        }
      }
    }
  },
  "tm:optional": [
    "/properties/AccumulatedLatency",
