  "schemaDefinitions": {
    "StorageLogicEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.TMC.v2.StorageLogicEnumeration",
      "const": {
        "Other": 0,
        "FIFO": 1,
        "LIFO": 2,
        "FEFO": 3
      },
      "description": "The StorageLogicEnumeration describes standard loading and unloading material  configurations.",
      "properties": {
        "Other": {
          "description": "None of the below options.",
          "type": "integer"
        },
        "FIFO": {
          "description": "First-In, First-Out.",
          "type": "integer"
        },
        "LIFO": {
          "description": "Last-In, First-Out.",
          "type": "integer"
        },
        "FEFO": {
          "description": "First-Expired, First-Out.",
          "type": "integer"
        }
      }
    },
    "StorageMixingLogicEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.TMC.v2.StorageMixingLogicEnumeration",
      "const": {
        "Mixing": 0,
        "NonMixingByProduct": 1,
        "NonMixingByBatch": 2
      },
      "description": "The StorageMixingLogicEnumeration describes standard ways of mixing material in a material  storage buffer.",
      "properties": {
        "Mixing": {
          "description": "The material storage buffer containing a material accepts any other material.",
          "type": "integer"
        },
        "NonMixingByProduct": {
          "description": "The material storage buffer containing a material accepts other materials with the same MaterialDefinition.",
          "type": "integer"
        },
        "NonMixingByBatch": {
          "description": "The material storage buffer containing a material accepts other materials with the same MaterialLot.",
          "type": "integer"
        }
      }
    },
    "StateVariableType": {
      "dov:typeRef": "org.opcfoundation.UA.StateVariableType",
      "type": "string"
    },
    "MaterialLotVariableType": {
      "description": "The MaterialLotVariableType is a subtype of the MaterialQuantityVariableType. It is used to  provide the quantity for a material lot.",
      "dov:typeRef": "org.opcfoundation.UA.TMC.v2.MaterialLotVariableType",
      "type": "number",
      "minimum": -1.80e+308,
      "maximum": 1.80e+308
    },
    "MaterialRateType": {
      "description": "The MaterialRateType is a subtype of the MaterialQuantityVariableType. It is used to provide  the rate for a material flow rate.",
      "dov:typeRef": "org.opcfoundation.UA.TMC.v2.MaterialRateType",
