        },
        "SETUP": {
          "description": "The machine is in setup mode",
          "type": "integer"
        },
        "SLEEP": {
          "description": "The machine is in sleep mode. Machine is still switched on, energy consumption reduced by e.g. reducing heating, switching drives off. Production is not possible.",
          "type": "integer"
