    "CertificateType": {
      "type": "string",
      "readOnly": true
    },
    "ExpirationDate": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "ExpirationLimit": {
      "type": "string",
      "pattern": "^P(?!$)(?:(?:(?:(?:\\d+Y)|(?:\\d+\\.\\d+Y$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?)|(?:(?:(?:\\d+W)|(?:\\d+\\.\\d+W$))?))(?:(?:\\d+D)|(?:\\d+\\.\\d+D$))?(?:T(?!$)(?:(?:\\d+H)|(?:\\d+\\.\\d+H$))?(?:(?:\\d+M)|(?:\\d+\\.\\d+M$))?(?:\\d+(?:\\.\\d+)?S)?)?$",
      "readOnly": true
    }
  }
}