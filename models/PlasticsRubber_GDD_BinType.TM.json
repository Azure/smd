  "schemaDefinitions": {
    "AirFlowModeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GDD.AirFlowModeEnumeration",
      "const": {
        "CONTINUOUS": 0,
        "INTERVAL": 1,
        "OPTIMIZED": 2
      },
      "description": "Determines the air flow, either from a fan or from compressed air. ",
      "properties": {
        "CONTINUOUS": {
          "description": "constant flow",
          "type": "integer"
        },
        "INTERVAL": {
          "description": "changing cyclic between low or no and high or normal flow  ",
          "type": "integer"
        },
        "OPTIMIZED": {
          "description": "Energy optimized mode (depending e.g. on throughput / humidity…)",
          "type": "integer"
        }
      }
    },
    "AirSourceEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GDD.AirSourceEnumeration",
      "const": {
        "FRESH_AIR": 0,
        "RETURN_AIR": 1
      },
      "description": "Determines the source of the air.",
      "properties": {
        "FRESH_AIR": {
          "description": "The dryer is working with fresh air",
          "type": "integer"
        },
        "RETURN_AIR": {
          "description": "The dryer is working with return air, closed loop",
          "type": "integer"
        }
      }
    },
    "DryingLevelEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GDD.DryingLevelEnumeration",
      "const": {
        "LOW": 0,
        "MEDIUM": 1,
        "HIGH": 2
      },
      "description": "Indicates how much drying is required.",
      "properties": {
        "LOW": {
          "description": "The granulate requires a low level drying.",
          "type": "integer"
        },
        "MEDIUM": {
          "description": "The granulate requires a medium level drying.",
          "type": "integer"
        },
        "HIGH": {
          "description": "The granulate requires a high level drying.",
          "type": "integer"
        }
      }
    },
    "DryingModeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GDD.DryingModeEnumeration",
      "const": {
        "BATCH": 0,
        "CONTINUOUS": 1,
        "COMBINED": 2
      },
      "description": "The drying mode determines the drying process.",
      "properties": {
        "BATCH": {
          "description": "The granulate in the dryer is dried for a certain period of time and then switched to drying protection.",
          "type": "integer"
        },
        "CONTINUOUS": {
          "description": "The granulate in the dryer is dried continuously.",
          "type": "integer"
        },
        "COMBINED": {
          "description": "The very wet granulate in the dryer is dried for a certain period of time, after which it is dried continuously.",
          "type": "integer"
        }
      }
    },
    "FunctionStatusEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PlasticsRubber.GDD.FunctionStatusEnumeration",
      "const": {
        "OFF": 0,
        "ON": 1,
        "REQUESTED_OFF": 2,
        "REQUESTED_ON": 3
      },
      "description": "Provides information about the current operation state of a function.",
      "properties": {
        "OFF": {
          "description": "Function is switched off",
          "type": "integer"
        },
        "ON": {
          "description": "Function is switched on",
          "type": "integer"
        },
        "REQUESTED_OFF": {
          "description": "Function is switched on AND requested to be switched off by the client",
          "type": "integer"
        },
        "REQUESTED_ON": {
          "description": "Function is switched off AND requested to be switched on by the client",
          "type": "integer"
        }
      }
    }
  },
