  "schemaDefinitions": {
    "RioSignalTypeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioSignalTypeEnumeration",
      "const": {
        "CURRENT_4_20_mA": 0,
        "CURRENT_0_20_mA": 1,
        "VOLTAGE_0_10_V": 2,
        "VOLTAGE_10_10_V": 3,
        "HART": 4,
        "DIGITAL_0_24V": 5,
        "NAMUR": 6,
        "MANUFACTURER_SPECIFIC": 7
      },
      "properties": {
        "CURRENT_4_20_mA": {
          "description": "Current, 4 to 20 mA",
          "type": "integer"
        },
        "CURRENT_0_20_mA": {
          "description": "Current, 0 to 20 mA",
          "type": "integer"
        },
        "VOLTAGE_0_10_V": {
          "description": "Voltage, 0 to 10 V",
          "type": "integer"
        },
        "VOLTAGE_10_10_V": {
          "description": "Voltage, -10 to 10 V",
          "type": "integer"
        },
        "HART": {
          "description": "HART Communication (this includes 4 to 20 mA)",
          "type": "integer"
        },
        "DIGITAL_0_24V": {
          "description": "Digital, 0/24 V (discrete input or output only)",
          "type": "integer"
        },
        "NAMUR": {
          "description": "See NAMUR NE 107.",
          "type": "integer"
        },
        "MANUFACTURER_SPECIFIC": {
          "description": "None of the above.",
          "type": "integer"
        }
      }
    },
    "RioSubstitutePolicyEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioSubstitutePolicyEnumeration",
      "const": {
        "USE_SUBSTITUTE_VALUE": 0,
        "USE_LAST_VALID_VALUE": 1,
        "USE_ACTUAL_VALUE": 2,
        "Unspecified": 255
      },
      "properties": {
        "USE_SUBSTITUTE_VALUE": {
          "description": "The value of the SubstituteValue configuration property is used as substitute value if an error condition is detected.",
          "type": "integer"
        },
        "USE_LAST_VALID_VALUE": {
          "description": "The last valid value is used as substitute value if an error condition is detected.",
          "type": "integer"
        },
        "USE_ACTUAL_VALUE": {
          "description": "No substitute value is used, the process value can have the wrong calculated value and status even if the error condition is detected.",
          "type": "integer"
        },
        "Unspecified": {
          "description": "No information about the status is given.",
          "type": "integer"
        }
      }
    },
    "RioFaDigitalOutputConfigVariableType": {
      "title": "RioFaDigitalOutputConfigDataType",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioFaDigitalOutputConfigVariableType",
      "required": [
        "SignalType",
        "WireCheckEnabled",
        "SupplyVoltageCheckEnabled",
        "LoadVoltageCheckEnabled",
        "SubstitutePolicy",
        "SubstituteValue",
        "SubstituteTime"
      ],
      "properties": {
        "SignalType": {
          "title": "RioSignalTypeEnumeration",
          "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioSignalTypeEnumeration",
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "WireCheckEnabled": {
          "type": "boolean"
        },
        "SupplyVoltageCheckEnabled": {
          "type": "boolean"
        },
        "LoadVoltageCheckEnabled": {
          "type": "boolean"
        },
        "SubstitutePolicy": {
          "title": "RioSubstitutePolicyEnumeration",
          "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioSubstitutePolicyEnumeration",
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "SubstituteValue": {
          "type": "boolean"
        },
        "SubstituteTime": {
          "type": "number",
          "minimum": -3.40e+38,
          "maximum": 3.40e+38
        }
      }
    },
    "RioFaDigitalProcessValueVariableType": {
      "title": "RioFaDigitalProcessValueDataType",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioFaDigitalProcessValueVariableType",
      "required": [
        "Value",
        "Qualifier",
        "Quality"
      ],
      "properties": {
        "Value": {
          "description": "Current value.",
          "type": "boolean"
        },
        "Qualifier": {
          "description": "Current status.",
          "type": "boolean"
        },
        "Quality": {
          "description": "Value of RioQualityEnumeration.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  },
