  "schemaDefinitions": {
    "RioChannelModeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioChannelModeEnumeration",
      "const": {
        "AUTO": 0,
        "MANUAL": 1,
        "OUT_OF_SERVICE": 2
      },
      "properties": {
        "AUTO": {
          "description": "Do not use the value of the ManualProcessValue variable as Process Value of the RIO Channel.",
          "type": "integer"
        },
        "MANUAL": {
          "description": "Use the value of the ManualProcessValue variable as Process Value of the RIO Channel.",
          "type": "integer"
        },
        "OUT_OF_SERVICE": {
          "description": "The RIO Channel is out of service.",
          "type": "integer"
        }
      }
    },
    "RioSignalTypeEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioSignalTypeEnumeration",
      "const": {
        "CURRENT_4_20_mA": 0,
        "CURRENT_0_20_mA": 1,
        "VOLTAGE_0_10_V": 2,
        "VOLTAGE_10_10_V": 3,
        "HART": 4,
        "DIGITAL_0_24V": 5,
        "NAMUR": 6,
        "MANUFACTURER_SPECIFIC": 7
      },
      "properties": {
        "CURRENT_4_20_mA": {
          "description": "Current, 4 to 20 mA",
          "type": "integer"
        },
        "CURRENT_0_20_mA": {
          "description": "Current, 0 to 20 mA",
          "type": "integer"
        },
        "VOLTAGE_0_10_V": {
          "description": "Voltage, 0 to 10 V",
          "type": "integer"
        },
        "VOLTAGE_10_10_V": {
          "description": "Voltage, -10 to 10 V",
          "type": "integer"
        },
        "HART": {
          "description": "HART Communication (this includes 4 to 20 mA)",
          "type": "integer"
        },
        "DIGITAL_0_24V": {
          "description": "Digital, 0/24 V (discrete input or output only)",
          "type": "integer"
        },
        "NAMUR": {
          "description": "See NAMUR NE 107.",
          "type": "integer"
        },
        "MANUFACTURER_SPECIFIC": {
          "description": "None of the above.",
          "type": "integer"
        }
      }
    },
    "RioSubstitutePolicyEnumeration": {
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.PNRIO.RioSubstitutePolicyEnumeration",
      "const": {
        "USE_SUBSTITUTE_VALUE": 0,
        "USE_LAST_VALID_VALUE": 1,
        "USE_ACTUAL_VALUE": 2,
        "Unspecified": 255
      },
      "properties": {
        "USE_SUBSTITUTE_VALUE": {
          "description": "The value of the SubstituteValue configuration property is used as substitute value if an error condition is detected.",
          "type": "integer"
        },
        "USE_LAST_VALID_VALUE": {
          "description": "The last valid value is used as substitute value if an error condition is detected.",
          "type": "integer"
        },
        "USE_ACTUAL_VALUE": {
          "description": "No substitute value is used, the process value can have the wrong calculated value and status even if the error condition is detected.",
          "type": "integer"
        },
        "Unspecified": {
          "description": "No information about the status is given.",
          "type": "integer"
        }
      }
    },
