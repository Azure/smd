  "links": [],
  "schemaDefinitions": {
    "SignalDataType": {
      "description": "This structure contains the signal information which is used in SetIOSignals and GetIOSignals methods.",
      "type": "object",
      "dov:typeRef": "org.opcfoundation.UA.IJT.Base.SignalDataType",
      "required": [
        "SignalId",
        "SignalValue",
        "SignalDescription",
        "SignalType"
      ],
      "properties": {
        "SignalId": {
          "description": "It is the identifier of the signal.",
          "type": "string"
        },
        "SignalValue": {
          "description": "It is the value of the signal.",
          "type": "number"
        },
        "SignalDescription": {
          "description": "It is the description of the signal.",
          "type": "string"
        },
        "SignalType": {
          "description": "It is the type of the signal.",
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      }
    }
  }
